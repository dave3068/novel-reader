// ---------------------------------------------------------------------------
// 基础组件（自绘；五态与可访问名称）
// ---------------------------------------------------------------------------

// UI Shell 导航项（项高 48；选中 600 + 底部 2 像素 主色；文字自适应）。
component NavItem inherits Rectangle {
    in property <string> caption: "";
    in property <bool> active: false;
    callback activated();

    width: max(UiMetrics.nav-tab-min-width, nav-label.preferred-width + UiMetrics.space-32);
    height: UiMetrics.nav-tab-height;
    background: transparent;

    nav-label := Text {
        text: root.caption;
        x: (parent.width - self.width) / 2;
        y: 0;
        height: parent.height - UiMetrics.nav-indicator-height;
        font-size: UiMetrics.ui-font-size;
        font-weight: root.active ? 600 : 400;
        color: Skin.header-text;
        vertical-alignment: center;
    }
    if root.active : Rectangle {
        x: 0;
        y: parent.height - self.height;
        width: parent.width;
        height: UiMetrics.nav-indicator-height;
        background: Skin.primary;
    }
    TouchArea {
        clicked => {
            root.activated();
        }
    }
}

// 图标（几何线框；颜色由 `color` 注入）。
component Icon inherits Path {
    in property <string> shape: "";
    in property <length> size: UiMetrics.icon-size;
    in property <color> color: Skin.text-primary;
    // 填充色（默认透明 = 线框图标；三角等实心图标传入与 stroke 同色）。
    in property <color> fill-color: transparent;
    width: root.size;
    height: root.size;
    commands: root.shape;
    stroke: root.color;
    stroke-width: UiMetrics.hairline;
    fill: root.fill-color;
    viewbox-width: 16;
    viewbox-height: 16;
}

// 状态 Tag（高 20 / 圆角 999；5 种语义槽位）。
component Tag inherits Rectangle {
    in property <string> text: "";
    // 0=中性（灰）1=信息（蓝）2=成功（绿）3=警告（黄）4=错误（红）
    in property <int> tone: 0;
    height: UiMetrics.tag-height;
    width: max(UiMetrics.space-24, tag-text.preferred-width + UiMetrics.space-12);
    border-radius: self.height / 2;
    background: tone == 2 ? Skin.success-soft : (tone == 3 ? Skin.warning-soft : (tone == 4 ? Skin.error-soft : (tone == 1 ? Skin.primary-soft : Skin.layer-01)));
    border-width: UiMetrics.hairline;
    border-color: tone == 2 ? Skin.support-success : (tone == 3 ? Skin.support-warning : (tone == 4 ? Skin.support-error : (tone == 1 ? Skin.primary-border : Skin.border-subtle)));

    tag-text := Text {
        text: root.text;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        font-size: UiMetrics.tag-font-size;
        color: tone == 2 ? Skin.support-success : (tone == 3 ? Skin.support-warning : (tone == 4 ? Skin.support-error : (tone == 1 ? Skin.primary-strong : Skin.text-secondary)));
        vertical-alignment: center;
    }
}

// 分组说明块（常驻说明；无标题、无关闭按钮；正文自动换行不截断）。
// 2026-10-04：替代「标题 + 说明拼成一行」的旧做法（窄窗必被裁）。
component SectionNote inherits Rectangle {
    in property <string> text: "";
    // 0=中性 1=信息 3=警告
    in property <int> tone: 3;

    background: tone == 1 ? Skin.primary-soft : (tone == 3 ? Skin.warning-soft : Skin.layer-02);
    border-width: UiMetrics.hairline;
    border-color: tone == 1 ? Skin.primary-border : (tone == 3 ? Skin.support-warning : Skin.border-subtle);
    border-radius: UiMetrics.space-4;

    // 左侧语义色条（宽 space-4）。注意：组件有 `border-radius`，色条贴x:0 时
    // 两端会随圆角被裁出弧形，**视觉上比实际宽度更窄**，正文起点若只按space-16 计算
    // 会显得贴边（2026-10-04 主人实测反馈：文字紧贴色条）。
    Rectangle {
        x: 0;
        y: 0;
        width: UiMetrics.space-4 - UiMetrics.hairline;
        height: parent.height;
        background: root.tone == 1 ? Skin.primary : (root.tone == 3 ? Skin.support-warning : Skin.text-placeholder);
    }
    // 正文起点用 space-24（2026-10-04 主人反馈「文字紧贴左侧色条」后加大）：
    // 起点须**从色条宽度累加**，否则只是相对组件左缘的绝对值、观感依然贴边。
    // 24 − (4−1) = 与色条右缘净距21 像素，左右各留24 像素，视觉呼吸充足。
    // 正文：高度由**内容决定**（preferred-height 即 Slint 真实换行后的高度）。
    note-body := Text {
        x: UiMetrics.space-24;
        y: UiMetrics.space-12;
        width: parent.width - self.x - UiMetrics.space-24;
        text: root.text;
        font-size: UiMetrics.caption-font-size;
        color: Skin.text-secondary;
        wrap: word-wrap;
        height: self.preferred-height;
    }
    // 实测高度 = 顶部留白 + 正文真实高度 + **底部留白**。
    // 底部留白比顶部**大**（2026-10-04 主人反馈「文字底部与块底重叠」）：
    // `preferred-height` 是**行框高**，中文字体descent 使实际墨迹底部比行框底
    // 再高若干像素；若上下留白相等，视觉上底边就比顶边紧。故底部额外加 space-8。
    in property <length> measured-height: UiMetrics.space-12 + note-body.preferred-height + UiMetrics.space-24;
    // 内容高度变化（含窗口宽度变化引起的换行数变化）时回报给外层，
    // 由外层转交 Rust 重算整页高度。`changed` 在高度真正变化时才触发，可避免抖动。
    callback height-measured(length);
    height: root.measured-height;
    changed measured-height => {
        root.height-measured(self.measured-height);
    }
}

// 图标按钮（32 / 行内 28；必须带 tooltip 与可访问名称）。
//
// `caption` 是动作名（结构性格文案）；`shortcut` 是 Rust 投影的**已实现**快捷键
// （tooltip 与快捷键面板同源；未实现时不投影文本）。
component IconButton inherits Rectangle {
    in property <string> caption: "";
    in property <string> shortcut: "";
    in property <string> shape: "";
    in property <bool> enabled: true;
    in property <bool> selected: false;
    in property <bool> compact: false;
    in property <bool> danger: false;
    // tooltip 出现在下方（工具条 / 页头）或上方（状态栏）。
    in property <bool> tip-below: false;
    // 位于深色顶栏（前景取 header-text，与品牌图标一致）。
    in property <bool> on-header: false;
    // 实心图标（三角等）。
    in property <bool> filled: false;
    // 提示交由**窗口顶层**渲染（顶栏按钮用：其下方的阅读工具条会遮住自绘提示）。
    in property <bool> tip-host: false;
    // 按钮左缘在**窗口坐标**中的 x（使用点按令牌反推；顶层据此定位并夹紧）。
    in property <length> tip-anchor-x: 0px;
    // 悬停变化时上报提示：文本（空串 = 收回）/ 锚点 x / 期望方位（1=下 0=上）。
    callback tip-request(string, length, int);
    in property <length> button-size: root.compact ? UiMetrics.icon-button-compact-size : UiMetrics.icon-button-size;
    callback activated();

    width: root.button-size;
    height: root.button-size;
    background: !root.enabled ? Skin.disabled-bg : (area.has-hover ? (root.selected ? Skin.primary-soft : (root.on-header ? Skin.header-hover : Skin.layer-01)) : (root.selected ? Skin.primary-soft : transparent));
    border-width: UiMetrics.hairline;
    border-color: !root.enabled ? Skin.disabled-border : (root.selected ? Skin.primary : (root.danger ? Skin.support-error : Skin.border-strong));
    border-radius: self.height / 2;
    accessible-role: button;
    accessible-label: root.caption;
    accessible-enabled: root.enabled;

    area := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.activated();
        }
        changed has-hover => {
            // tip-host 模式：只上报，由窗口顶层渲染（避免被同层更高的条带遮挡）。
            if (root.tip-host) {
                root.tip-request(
                    self.has-hover && root.caption != ""
                        ? (root.shortcut == "" ? root.caption : root.caption + "（" + root.shortcut + "）")
                        : "",
                    root.tip-anchor-x,
                    root.tip-below ? 1 : 0
                );
            }
        }
    }

    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        shape: root.shape;
        size: UiMetrics.icon-size;
        color: !root.enabled ? Skin.disabled-text : (root.danger ? Skin.support-error : (root.on-header ? Skin.header-text : (root.selected ? Skin.primary : Skin.text-primary)));
        fill-color: root.filled ? (!root.enabled ? Skin.disabled-text : (root.danger ? Skin.support-error : (root.on-header ? Skin.header-text : (root.selected ? Skin.primary : Skin.text-primary)))) : transparent;
    }

    // 提示：宽度按文案自适应；横向**贴按钮对齐并夹紧在父级内**（靠右按钮不再出窗），
    // 纵向按 `tip-below` 放置（条带/页头的按钮向下、状态栏的按钮向上）。
    if (area.has-hover || area.pressed) && root.caption != "" && !root.tip-host : Rectangle {
        // 贴右侧时右对齐、否则左对齐（x 固定 0 会让靠右按钮的提示伸出窗口）。
        x: min(0px, parent.width - self.width);
        y: root.tip-below ? parent.height + UiMetrics.space-4 : 0px - self.height - UiMetrics.space-4;
        width: tip-text.preferred-width + UiMetrics.space-12;
        height: UiMetrics.space-24;
        background: Skin.toast-bg;
        border-radius: UiMetrics.toast-radius;

        tip-text := Text {
            text: root.shortcut == "" ? root.caption : root.caption + "（" + root.shortcut + "）";
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            font-size: UiMetrics.caption-font-size;
            color: Skin.toast-text;
        }
    }
}

// 文字按钮（Primary / Secondary / Ghost / Danger 四型）。
component TextButton inherits Rectangle {
    // 0=Primary 1=Secondary 2=Ghost 3=Danger
    in property <int> variant: 0;
    in property <string> caption: "";
    in property <bool> enabled: true;
    in property <bool> compact: false;
    // 左右内边距（紧凑条里可调小，如卡片菜单条）。
    in property <length> padding-x: UiMetrics.space-16;
    callback activated();

    // 宽度按文字自然宽 + 左右内边距；必须显式声明，
    // 否则作为纯 Rectangle 会展开铺满父级（会遮住同一页头里的其他控件）。
    width: max(UiMetrics.space-48, label.preferred-width + 2 * root.padding-x);
    height: root.compact ? UiMetrics.button-height-compact : UiMetrics.button-height;
    background: !root.enabled ? Skin.disabled-bg : (area.has-hover ? (variant == 0 ? Skin.primary-hover : (variant == 3 ? Skin.error-soft : (variant == 1 ? Skin.primary-soft : Skin.layer-01))) : (variant == 0 ? Skin.primary : (variant == 3 ? Skin.error-soft : (variant == 2 ? transparent : Skin.layer-02))));
    border-width: UiMetrics.hairline;
    border-color: !root.enabled ? Skin.disabled-border : (variant == 0 ? transparent : (variant == 3 ? Skin.support-error : (variant == 2 ? Skin.border-subtle : Skin.primary)));
    accessible-role: button;
    accessible-label: root.caption;
    accessible-enabled: root.enabled;

    area := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.activated();
        }
    }

    label := Text {
        text: root.caption;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        font-size: UiMetrics.ui-font-size;
        font-weight: root.variant == 0 ? 500 : 400;
        color: !root.enabled ? Skin.disabled-text : (root.variant == 0 ? Skin.on-primary : (root.variant == 3 ? Skin.support-error : Skin.primary-strong));
        vertical-alignment: center;
    }
}

// 文本输入框（Carbon 口径：1 像素 底边，聚焦 2 像素 主色底边）。
//
// 内部使用 Slint 内置 `LineEdit` 负责真实文本输入与 IME；其自带边框由外层裁切与
// 覆盖条遮住（本组件的 chrome 才是可见边框），保证与设计一致。
// 文本输入框（Carbon 口径：1 像素 底边，聚焦 2 像素 主色底边）。
//
// 使用 Slint 低层 `TextInput`（与内置 LineEdit 同一内核：IME / 剪贴板 / 选区一致），
// 但 chrome 完全自绘，颜色取自设计令牌（Skin）。
component TextField inherits Rectangle {
    in property <string> text: "";
    in property <string> placeholder: "";
    in property <string> label: "";
    in property <bool> enabled: true;
    in property <bool> compact: false;
    in property <bool> leading-icon: false;
    in property <length> horizontal-padding: UiMetrics.space-8;
    out property <bool> focused: input.has-focus;
    callback edited(string);

    height: root.compact ? UiMetrics.button-height-compact : UiMetrics.button-height;
    background: root.enabled ? Skin.field-01 : Skin.disabled-bg;
    border-width: 0px;
    accessible-role: text-input;
    accessible-label: root.label;

    forward-focus: input;

    // 点击任意处聚焦输入（与内置控件一致的可点区域）。
    TouchArea {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        clicked => {
            input.focus();
        }
    }

    if (root.leading-icon) : Icon {
        x: root.horizontal-padding;
        y: (parent.height - self.height) / 2;
        shape: Icons.search;
        size: UiMetrics.icon-size;
        color: Skin.text-placeholder;
    }

    input := TextInput {
        x: root.leading-icon ? (UiMetrics.icon-size + UiMetrics.space-8 + root.horizontal-padding) : root.horizontal-padding;
        y: UiMetrics.space-4;
        width: parent.width - self.x - root.horizontal-padding;
        height: parent.height - 2 * UiMetrics.space-4;
        text: root.text;
        enabled: root.enabled;
        read-only: !root.enabled;
        single-line: true;
        font-size: UiMetrics.ui-font-size;
        color: root.enabled ? Skin.text-primary : Skin.text-disabled;
        selection-background-color: Skin.primary;
        selection-foreground-color: Skin.on-primary;
        horizontal-alignment: left;
        vertical-alignment: center;
        edited => {
            root.edited(input.text);
        }
        accepted => {
            root.edited(input.text);
        }
    }

    // 占位符（TextInput 无 placeholder-text：文本为空且无预编辑文本时显示）。
    if root.text == "" && input.preedit-text == "" : Text {
        x: root.leading-icon ? (UiMetrics.icon-size + UiMetrics.space-8 + root.horizontal-padding) : root.horizontal-padding;
        y: 0;
        width: parent.width - self.x - root.horizontal-padding;
        height: parent.height;
        text: root.placeholder;
        font-size: UiMetrics.ui-font-size;
        color: Skin.text-placeholder;
        vertical-alignment: center;
        overflow: elide;
    }

    // 底边（聚焦 2 像素 主色）。
    Rectangle {
        x: 0;
        y: parent.height - self.height;
        width: parent.width;
        height: input.has-focus ? UiMetrics.focus-ring-width : UiMetrics.hairline;
        background: !root.enabled ? Skin.disabled-border : (input.has-focus ? Skin.primary : Skin.border-strong);
    }
}

// 滑杆（轨道 2 + 把手 16；两端边界值 + 数值框由调用方提供）。
component SliderBar inherits Rectangle {
    in property <int> value: 0;
    in property <int> minimum: 0;
    in property <int> maximum: 100;
    in property <bool> enabled: true;
    callback changed(int);

    height: UiMetrics.slider-handle-size;
    background: transparent;

    Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: parent.width;
        height: UiMetrics.slider-track-height;
        background: Skin.control-track;
    }
    Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: (parent.width - UiMetrics.slider-handle-size) * (root.value - root.minimum) / max(1, root.maximum - root.minimum) + UiMetrics.slider-handle-size / 2;
        height: UiMetrics.slider-track-height;
        background: Skin.primary;
    }
    handle := Rectangle {
        x: (parent.width - self.width) * (root.value - root.minimum) / max(1, root.maximum - root.minimum);
        y: (parent.height - self.height) / 2;
        width: UiMetrics.slider-handle-size;
        height: UiMetrics.slider-handle-size;
        border-radius: self.height / 2;
        background: area.has-hover ? Skin.primary-hover : Skin.primary;
        border-width: UiMetrics.hairline;
        border-color: Skin.background;
    }
    area := TouchArea {
        enabled: root.enabled;
        clicked => {
            let unit = (parent.width - UiMetrics.slider-handle-size) / max(1, root.maximum - root.minimum);
            let raw = round((self.mouse-x - UiMetrics.slider-handle-size / 2) / max(UiMetrics.hairline, unit)) + root.minimum;
            root.changed(min(root.maximum, max(root.minimum, raw)));
        }
        moved => {
            if (self.pressed) {
                let unit = (parent.width - UiMetrics.slider-handle-size) / max(1, root.maximum - root.minimum);
                let raw = round((self.mouse-x - UiMetrics.slider-handle-size / 2) / max(UiMetrics.hairline, unit)) + root.minimum;
                root.changed(min(root.maximum, max(root.minimum, raw)));
            }
        }
    }
}

// 开关（32×18；用于布尔项）。
component SwitchToggle inherits Rectangle {
    in property <bool> checked: false;
    in property <bool> enabled: true;
    callback toggled(bool);

    width: UiMetrics.switch-width;
    height: UiMetrics.switch-height;
    border-radius: self.height / 2;
    background: !root.enabled ? Skin.disabled-bg : (root.checked ? Skin.primary : Skin.control-track);
    border-width: UiMetrics.hairline;
    border-color: !root.enabled ? Skin.disabled-border : (root.checked ? Skin.primary : Skin.border-strong);

    Rectangle {
        x: root.checked ? parent.width - self.width - UiMetrics.space-2 : UiMetrics.space-2;
        y: (parent.height - self.height) / 2;
        width: parent.height - 2 * UiMetrics.space-2;
        height: parent.height - 2 * UiMetrics.space-2;
        border-radius: self.height / 2;
        background: root.enabled ? Skin.background : Skin.disabled-text;
    }
    area := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.toggled(!root.checked);
        }
    }
}

// 单选圆点 + 标签（互斥项 ≤4 时使用）。
component RadioItem inherits Rectangle {
    in property <string> caption: "";
    in property <bool> checked: false;
    in property <bool> enabled: true;
    callback selected();

    height: UiMetrics.space-24;
    background: transparent;

    Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: UiMetrics.radio-size;
        height: UiMetrics.radio-size;
        border-radius: self.height / 2;
        background: Skin.field-01;
        border-width: root.checked ? UiMetrics.space-4 : UiMetrics.hairline;
        border-color: root.checked ? Skin.primary : (root.enabled ? Skin.control-track : Skin.disabled-border);
    }
    Text {
        text: root.caption;
        x: UiMetrics.radio-size + UiMetrics.space-8;
        y: 0;
        width: parent.width - UiMetrics.radio-size - UiMetrics.space-8;
        height: parent.height;
        font-size: UiMetrics.ui-font-size;
        color: root.enabled ? Skin.text-primary : Skin.disabled-text;
        vertical-alignment: center;
        overflow: elide;
    }
    area := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.selected();
        }
    }
}

// 线性进度条（2 像素；可交互变体支持点击/拖拽跳转）。
component ProgressTrack inherits Rectangle {
    in property <int> permille: 0;
    in property <bool> interactive: false;
    out property <bool> hovering: area.has-hover;
    out property <length> pointer-x: area.mouse-x;
    callback seek(float);

    height: area.has-hover && root.interactive ? UiMetrics.progress-bar-hover-height : UiMetrics.progress-bar-height;
    background: Skin.border-subtle;

    Rectangle {
        x: 0;
        y: (parent.height - UiMetrics.progress-bar-height) / 2;
        width: parent.width * min(1000, max(0, root.permille)) / 1000;
        height: UiMetrics.progress-bar-height;
        background: Skin.primary;
    }

    area := TouchArea {
        enabled: root.interactive;
        clicked => {
            root.seek(self.mouse-x / max(UiMetrics.hairline, parent.width));
        }
        moved => {
            if (self.pressed) {
                root.seek(self.mouse-x / max(UiMetrics.hairline, parent.width));
            }
        }
    }
}

// 自绘滚动条（宽 8；可拖拽与点击轨道）。
component ScrollBar inherits Rectangle {
    in property <float> ratio: 0;
    in property <float> handle-ratio: 0.2;
    callback seek(float);

    width: UiMetrics.scrollbar-width;
    background: Skin.scrollbar-track;
    border-radius: self.width / 2;

    handle := Rectangle {
        x: 0;
        width: parent.width;
        height: max(UiMetrics.scrollbar-min-handle, parent.height * root.handle-ratio);
        y: (parent.height - self.height) * root.ratio;
        background: area.has-hover ? Skin.primary : Skin.scrollbar-handle;
        border-radius: self.width / 2;
    }
    // 命中区比视觉条更宽（8 像素太窄，鼠标很难抓住）；纵向与轨道一致。
    area := TouchArea {
        x: 0px - UiMetrics.scrollbar-width;
        y: 0;
        width: parent.width + 2 * UiMetrics.scrollbar-width;
        height: parent.height;
        clicked => {
            root.seek((self.mouse-y - handle.height / 2) / max(UiMetrics.hairline, parent.height - handle.height));
        }
        moved => {
            if (self.pressed) {
                root.seek((self.mouse-y - handle.height / 2) / max(UiMetrics.hairline, parent.height - handle.height));
            }
        }
    }
}

// 空态（64 像素 灰图标 + 20/600 标题 + 14 说明 + 唯一主按钮 + 补充说明）。
component EmptyState inherits Rectangle {
    in property <string> title: "";
    in property <string> description: "";
    in property <[string]> notes: [];
    in property <string> action-label: "";
    in property <string> shape: Icons.book;
    callback activated();

    background: transparent;

    VerticalLayout {
        x: (parent.width - self.width) / 2;
        y: UiMetrics.space-48;
        width: min(parent.width - 2 * UiMetrics.space-16, UiMetrics.card-width * 2);
        spacing: UiMetrics.space-16;
        alignment: start;

        Rectangle {
            height: UiMetrics.empty-icon-size;
            background: transparent;

            Icon {
                x: (parent.width - self.width) / 2;
                shape: root.shape;
                size: UiMetrics.empty-icon-size;
                color: Skin.border-strong;
            }
        }
        Text {
            text: root.title;
            font-size: UiMetrics.heading-font-size;
            font-weight: 600;
            color: Skin.text-primary;
            horizontal-alignment: center;
            width: parent.width;
        }
        Text {
            text: root.description;
            font-size: UiMetrics.ui-font-size;
            color: Skin.text-secondary;
            horizontal-alignment: center;
            width: parent.width;
            wrap: word-wrap;
            height: self.preferred-height;
        }
        if root.action-label != "" : Rectangle {
            height: UiMetrics.button-height;
            background: transparent;

            TextButton {
                x: (parent.width - self.width) / 2;
                variant: 0;
                caption: root.action-label;
                activated => {
                    root.activated();
                }
            }
        }
        for note in root.notes : Text {
            text: "· " + note;
            font-size: UiMetrics.caption-font-size;
            color: Skin.text-placeholder;
            wrap: word-wrap;
            height: self.preferred-height;
            width: parent.width;
        }
    }
}

// 行内通知（左 3 像素 状态色 + 图标 + 标题 + 正文 + 动作 + 关闭）。
component InlineNotice inherits Rectangle {
    // tone：1=信息 2=成功 3=警告 4=错误
    in property <int> tone: 4;
    in property <string> title: "";
    in property <string> body: "";
    in property <string> action-label: "";
    callback activated();
    callback dismissed();

    background: tone == 2 ? Skin.success-soft : (tone == 3 ? Skin.warning-soft : (tone == 4 ? Skin.error-soft : Skin.primary-soft));

    Rectangle {
        x: 0;
        y: 0;
        width: UiMetrics.space-4 - UiMetrics.hairline;
        height: parent.height;
        background: root.tone == 2 ? Skin.support-success : (root.tone == 3 ? Skin.support-warning : (root.tone == 4 ? Skin.support-error : Skin.primary));
    }
    Icon {
        x: UiMetrics.space-16;
        y: UiMetrics.space-16;
        shape: root.tone == 2 ? Icons.check : (root.tone == 3 ? Icons.warning : (root.tone == 4 ? Icons.error : Icons.info));
        size: UiMetrics.icon-size;
        color: root.tone == 2 ? Skin.support-success : (root.tone == 3 ? Skin.support-warning : (root.tone == 4 ? Skin.support-error : Skin.primary));
    }
    Text {
        x: UiMetrics.space-16 + UiMetrics.icon-size + UiMetrics.space-8;
        y: UiMetrics.space-12;
        width: parent.width - self.x - UiMetrics.space-16 - (root.action-label == "" ? 0px : UiMetrics.space-24 * 4 + UiMetrics.space-24) - UiMetrics.icon-button-compact-size - UiMetrics.space-8;
        text: root.title;
        font-size: UiMetrics.ui-font-size;
        font-weight: 600;
        color: Skin.text-primary;
        wrap: word-wrap;
        height: self.preferred-height;
    }
    Text {
        x: UiMetrics.space-16 + UiMetrics.icon-size + UiMetrics.space-8;
        y: UiMetrics.space-12 + UiMetrics.space-24;
        width: parent.width - self.x - UiMetrics.space-16 - (root.action-label == "" ? 0px : UiMetrics.space-24 * 4 + UiMetrics.space-24) - UiMetrics.icon-button-compact-size - UiMetrics.space-8;
        text: root.body;
        font-size: UiMetrics.caption-font-size;
        color: Skin.text-secondary;
        wrap: word-wrap;
        height: self.preferred-height;
    }
    if root.action-label != "" : TextButton {
        x: parent.width - UiMetrics.space-16 - UiMetrics.icon-button-compact-size - UiMetrics.space-8 - self.width;
        y: (parent.height - self.height) / 2;
        variant: 1;
        compact: true;
        caption: root.action-label;
        activated => {
            root.activated();
        }
    }
    IconButton {
        x: parent.width - UiMetrics.space-16 - self.width;
        y: (parent.height - self.height) / 2;
        compact: true;
        caption: "关闭通知";
        shape: Icons.close;
        activated => {
            root.dismissed();
        }
    }
}

// Toast（深底白字；自动消失由 Rust 一次性定时器驱动）。
component Toast inherits Rectangle {
    in property <string> text: "";
    in property <string> action-label: "";
    callback activated();

    width: UiMetrics.toast-width;
    height: UiMetrics.toast-height;
    background: Skin.toast-bg;
    border-radius: UiMetrics.toast-radius;

    Text {
        x: UiMetrics.space-16;
        y: (parent.height - self.height) / 2;
        width: parent.width - UiMetrics.space-16 * 2 - (root.action-label == "" ? 0px : UiMetrics.space-24 * 5);
        text: root.text;
        font-size: UiMetrics.ui-font-size;
        color: Skin.toast-text;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.action-label != "" : TextButton {
        x: parent.width - UiMetrics.space-16 - self.width;
        y: (parent.height - self.height) / 2;
        compact: true;
        variant: 2;
        caption: root.action-label;
        activated => {
            root.activated();
        }
    }
}

// 弹窗遮罩（点击遮罩 = 取消；面板自身吞掉点击）。
component Overlay inherits Rectangle {
    background: Skin.overlay;
    callback dismissed();
    area := TouchArea {
        clicked => {
            root.dismissed();
        }
    }
}

// 确认弹窗（S13 / S14：标题 + 说明 + 可选勾选 + [取消][确认]）。
component ConfirmDialog inherits Rectangle {
    in property <string> title: "";
    in property <string> body: "";
    in property <string> note: "";
    in property <string> checkbox-label: "";
    in-out property <bool> checked: false;
    in property <string> confirm-label: "确认";
    in property <bool> danger: false;
    callback cancelled();
    callback confirmed(bool);

    Overlay {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        dismissed => {
            root.cancelled();
        }
    }

    panel := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: UiMetrics.modal-width-confirm;
        height: content.preferred-height + UiMetrics.space-24 * 2;
        background: Skin.layer-02;
        border-width: UiMetrics.hairline;
        border-color: Skin.border-strong;

        TouchArea { }

        content := VerticalLayout {
            x: UiMetrics.space-24;
            y: UiMetrics.space-24;
            width: parent.width - 2 * UiMetrics.space-24;
            spacing: UiMetrics.space-16;

            Text {
                text: root.title;
                font-size: UiMetrics.heading-font-size;
                font-weight: 600;
                color: Skin.text-primary;
                height: self.preferred-height;
            }
            Text {
                text: root.body;
                font-size: UiMetrics.ui-font-size;
                color: Skin.text-secondary;
                wrap: word-wrap;
                height: self.preferred-height;
            }
            if root.checkbox-label != "" : HorizontalLayout {
                spacing: UiMetrics.space-8;
                height: UiMetrics.space-24;
                SwitchToggle {
                    checked: root.checked;
                    toggled(checked) => {
                        root.checked = checked;
                    }
                }
                Text {
                    text: root.checkbox-label;
                    font-size: UiMetrics.ui-font-size;
                    color: Skin.text-primary;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }
            if root.note != "" : Text {
                text: root.note;
                font-size: UiMetrics.caption-font-size;
                color: Skin.text-placeholder;
                wrap: word-wrap;
                height: self.preferred-height;
            }
            HorizontalLayout {
                alignment: end;
                spacing: UiMetrics.space-8;
                height: UiMetrics.button-height;

                TextButton {
                    variant: 2;
                    caption: "取消";
                    activated => {
                        root.cancelled();
                    }
                }
                TextButton {
                    variant: root.danger ? 3 : 0;
                    caption: root.confirm-label;
                    activated => {
                        root.confirmed(root.checked);
                    }
                }
            }
        }
    }
}

// 选项弹窗（S8：居中弹窗 + 单选 + [取消][应用]）。
component ChoiceDialog inherits Rectangle {
    in property <string> title: "";
    in property <string> meta: "";
    in property <[ChoiceRow]> rows: [];
    in property <int> initial-index: 0;
    in-out property <int> selected-index: 0;
    callback cancelled();
    callback applied(int);

    init => {
        root.selected-index = root.initial-index;
    }

    Overlay {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        dismissed => {
            root.cancelled();
        }
    }

    panel := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: UiMetrics.modal-width-settings;
        height: content.preferred-height + UiMetrics.space-24 * 2;
        background: Skin.layer-02;
        border-width: UiMetrics.hairline;
        border-color: Skin.border-strong;

        TouchArea { }

        content := VerticalLayout {
            x: UiMetrics.space-24;
            y: UiMetrics.space-24;
            width: parent.width - 2 * UiMetrics.space-24;
            spacing: UiMetrics.space-16;

            Text {
                text: root.title;
                font-size: UiMetrics.heading-font-size;
                font-weight: 600;
                color: Skin.text-primary;
                height: self.preferred-height;
            }
            if root.meta != "" : Text {
                text: root.meta;
                font-size: UiMetrics.mono-font-size;
                color: Skin.text-secondary;
                height: self.preferred-height;
            }
            for row[i] in root.rows : Rectangle {
                height: UiMetrics.list-row-height;
                background: row.current ? Skin.primary-soft : transparent;
                accessible-role: list-item;
                accessible-label: row.name;

                RadioItem {
                    x: UiMetrics.space-8;
                    y: (parent.height - self.height) / 2;
                    width: parent.width - 2 * UiMetrics.space-8;
                    caption: row.name;
                    checked: i == root.selected-index;
                    selected => {
                        root.selected-index = i;
                    }
                }
            }
            HorizontalLayout {
                alignment: end;
                spacing: UiMetrics.space-8;
                height: UiMetrics.button-height;

                TextButton {
                    variant: 2;
                    caption: "取消";
                    activated => {
                        root.cancelled();
                    }
                }
                TextButton {
                    variant: 0;
                    caption: "应用";
                    activated => {
                        root.applied(root.selected-index);
                    }
                }
            }
        }
    }
}

// 快捷键说明弹窗（S15：已实现按键正常显示；建议项灰显 + 「建议」Tag）。
component ShortcutsDialog inherits Rectangle {
    in property <[ShortcutEntry]> rows: [];
    callback dismissed();

    Overlay {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        dismissed => {
            root.dismissed();
        }
    }

    panel := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: UiMetrics.modal-width-settings;
        height: content.preferred-height + UiMetrics.space-24 * 2;
        background: Skin.layer-02;
        border-width: UiMetrics.hairline;
        border-color: Skin.border-strong;

        TouchArea { }

        content := VerticalLayout {
            x: UiMetrics.space-24;
            y: UiMetrics.space-24;
            width: parent.width - 2 * UiMetrics.space-24;
            spacing: UiMetrics.space-12;

            Text {
                text: "快捷键";
                font-size: UiMetrics.heading-font-size;
                font-weight: 600;
                color: Skin.text-primary;
                height: self.preferred-height;
            }
            for row in root.rows : Rectangle {
                height: UiMetrics.space-24;
                background: transparent;
                accessible-role: list-item;
                accessible-label: row.action;

                Text {
                    text: row.action;
                    x: 0;
                    y: 0;
                    width: parent.width / 2;
                    height: parent.height;
                    font-size: UiMetrics.ui-font-size;
                    color: row.available ? Skin.text-primary : Skin.text-disabled;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Text {
                    text: row.keys;
                    x: parent.width / 2;
                    y: 0;
                    width: parent.width / 2 - UiMetrics.space-24 * 2;
                    height: parent.height;
                    font-family: "monospace";
                    font-size: UiMetrics.mono-font-size;
                    color: row.available ? Skin.text-secondary : Skin.text-disabled;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if !row.available : Tag {
                    x: parent.width - self.width;
                    y: (parent.height - self.height) / 2;
                    tone: 3;
                    text: "建议";
                }
            }
            HorizontalLayout {
                alignment: end;
                height: UiMetrics.button-height;

                TextButton {
                    variant: 2;
                    caption: "关闭";
                    activated => {
                        root.dismissed();
                    }
                }
            }
        }
    }
}

// 重命名弹窗（书架行「重命名…」；输入框聚焦时翻页键由 Rust 侧屏蔽）。
component RenameDialog inherits Rectangle {
    in property <string> title: "";
    in property <string> label: "";
    in property <string> initial-value: "";
    in-out property <string> value: "";
    callback cancelled();
    callback saved(string);

    init => {
        root.value = root.initial-value;
    }

    Overlay {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        dismissed => {
            root.cancelled();
        }
    }

    panel := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: UiMetrics.modal-width-confirm;
        height: content.preferred-height + UiMetrics.space-24 * 2;
        background: Skin.layer-02;
        border-width: UiMetrics.hairline;
        border-color: Skin.border-strong;

        TouchArea { }

        content := VerticalLayout {
            x: UiMetrics.space-24;
            y: UiMetrics.space-24;
            width: parent.width - 2 * UiMetrics.space-24;
            spacing: UiMetrics.space-16;

            Text {
                text: root.title;
                font-size: UiMetrics.heading-font-size;
                font-weight: 600;
                color: Skin.text-primary;
                height: self.preferred-height;
            }
            TextField {
                text: root.value;
                label: root.label;
                edited(text) => {
                    root.value = text;
                }
            }
            HorizontalLayout {
                alignment: end;
                spacing: UiMetrics.space-8;
                height: UiMetrics.button-height;

                TextButton {
                    variant: 2;
                    caption: "取消";
                    activated => {
                        root.cancelled();
                    }
                }
                TextButton {
                    variant: 0;
                    caption: "保存名称";
                    activated => {
                        root.saved(root.value);
                    }
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// S1 / S2 / S3 / S4：书架（表格 / 卡片 / 空态 / 失效通知）
// ---------------------------------------------------------------------------

// 行级菜单条（内联在**当前模式**的列表项下方；破坏性动作已分离）。
component RowMenuStrip inherits Rectangle {
    callback picked(string);
    // 紧凑模式（卡片视图）：宽度与卡片一致、按钮更紧凑、不显示「关闭」按钮
    // —— 显隐由所在卡片的「…」按钮切换。
    in property <bool> dense: false;

    height: UiMetrics.list-row-height;
    background: Skin.layer-02;
    border-width: UiMetrics.hairline;
    border-color: Skin.primary-border;
    // 轻量投影：让内联菜单条有浮层感（不回退为“页面内联元素”的观感）。
    drop-shadow-color: #00000026;
    drop-shadow-blur: UiMetrics.space-8;
    drop-shadow-offset-y: UiMetrics.space-4;

                HorizontalLayout {
                    // 卡片（紧凑）模式：按钮直接顶到最左侧，不显示「行操作」标签。
                    x: root.dense ? 0px : UiMetrics.space-16;
                    y: 0;
                    width: parent.width - 2 * self.x;
                    spacing: root.dense ? UiMetrics.space-4 : UiMetrics.space-8;
                    alignment: start;

                    // 条件存在（不是 visible:false）——不可见元素在布局里仍会占位，
                    // 会让按钮无法真正顶到左侧（真实缺陷回归）。
                    if !root.dense : Text {
                        text: "行操作";
                        font-size: UiMetrics.caption-font-size;
                        color: Skin.text-placeholder;
                        vertical-alignment: center;
                        width: UiMetrics.space-48 * 2;
                    }
                    TextButton {
                        variant: 1;
                        padding-x: root.dense ? UiMetrics.space-8 : UiMetrics.space-16;
                        compact: true;
                        caption: "重新关联";
                        activated => {
                            root.picked("relink");
                        }
                    }
                    TextButton {
                        variant: 1;
                        padding-x: root.dense ? UiMetrics.space-8 : UiMetrics.space-16;
                        compact: true;
                        caption: "重命名";
                        activated => {
                            root.picked("rename");
                        }
                    }
                    TextButton {
                        variant: 3;
                        padding-x: root.dense ? UiMetrics.space-8 : UiMetrics.space-16;
                        compact: true;
                        caption: "移出";
                        activated => {
                            root.picked("remove");
                        }
                    }
                    TextButton {
                        variant: 3;
                        padding-x: root.dense ? UiMetrics.space-8 : UiMetrics.space-16;
                        compact: true;
                        caption: "彻底删除";
                        activated => {
                            root.picked("purge");
                        }
                    }
                    TextButton {
                        variant: 2;
                        padding-x: root.dense ? UiMetrics.space-8 : UiMetrics.space-16;
                        compact: true;
                        visible: !root.dense;
                        caption: "关闭";
                        activated => {
                            root.picked("close");
                        }
                    }
                }
}

// 分类侧栏树行（V1.1）。
//
// 纯投影组件：缩进按 `depth`、高亮按 `selected`、置灰按 `move-blocked`。
// **不在此处做任何层级/计数/循环判定** —— 那些由 Rust 的
// `category_tree::project` 给出（门禁会扫本文件核对）。
component CategoryRowView inherits Rectangle {
    in property <string> row-id: "";
    in property <string> row-name: "";
    in property <int> row-depth: 0;
    in property <int> direct-count: 0;
    in property <int> total-count: 0;
    in property <bool> has-children: false;
    in property <bool> expanded: true;
    in property <bool> selected: false;
    in property <bool> move-blocked: false;
    in property <bool> virtual-row: false;
    in property <int> row-kind: 0;
    callback row-clicked(string);
    callback toggle(string);
    callback row-menu(string);

    height: UiMetrics.sidebar-row-height;
    background: root.selected ? Skin.primary-soft : Skin.field-01;

    // 选中态左侧 2 像素 主色条（与列表选中同口径）。
    if root.selected : Rectangle {
        x: 0;
        y: 0;
        width: UiMetrics.focus-ring-width;
        height: parent.height;
        background: Skin.primary;
    }

    // 展开箭头（有子分类时占位，空占位保持文字对齐）。
    Rectangle {
        x: UiMetrics.space-8 + root.row-depth * UiMetrics.sidebar-indent;
        y: (parent.height - UiMetrics.tree-arrow-size) / 2;
        width: UiMetrics.tree-arrow-size;
        height: UiMetrics.tree-arrow-size;
        background: transparent;

        // `Path` 无 `rotation` 属性（实测编译报错），故用**两种图标形状**表达
        // 展开/收起，而不是旋转同一个箭头。形状全部取自既有 `Icons`（不新增素材）。
        if root.has-children : Icon {
            shape: root.expanded ? Icons.chevron-down : Icons.chevron-right;
            size: UiMetrics.tree-arrow-size;
            x: 0;
            y: 0;
            color: root.selected ? Skin.primary-strong : Skin.text-secondary;
        }
        TouchArea {
            clicked => {
                root.toggle(root.row-id);
            }
        }
    }

    // 分类名（缩进后）。
    Text {
        x: UiMetrics.space-8 + UiMetrics.tree-arrow-size + UiMetrics.space-8
            + root.row-depth * UiMetrics.sidebar-indent;
        y: 0;
        width: parent.width - self.x - UiMetrics.space-8 - UiMetrics.space-24;
        height: parent.height;
        text: root.row-name;
        font-size: UiMetrics.ui-font-size;
        font-weight: root.selected ? 600 : 400;
        // 不可选（移动模式的自身与子孙）用 disabled 文字色。
        color: root.move-blocked ? Skin.text-disabled
            : (root.selected ? Skin.primary-strong : Skin.text-primary);
        vertical-alignment: center;
        overflow: elide;
    }

    // 书籍计数（直属；有子孙时显示合计）。
    Text {
        x: parent.width - self.width - UiMetrics.space-8;
        y: 0;
        height: parent.height;
        width: UiMetrics.space-24;
        text: root.has-children ? root.total-count : root.direct-count;
        font-size: UiMetrics.caption-font-size;
        color: root.move-blocked ? Skin.text-disabled : Skin.text-secondary;
        horizontal-alignment: right;
        vertical-alignment: center;
    }

    // 整行点击 = 选中（再点已选中项回到根，由 Rust 判定）。
    TouchArea {
        clicked => {
            root.row-clicked(root.row-id);
        }
    }

    // 行尾「…」：仅真实分类有（虚拟行不可重命名/移动/删除）。
    if !root.virtual-row : IconButton {
        x: parent.width - UiMetrics.icon-button-size - UiMetrics.space-4;
        y: (parent.height - UiMetrics.icon-button-size) / 2;
        shape: Icons.more;
        tip-below: false;
        activated => {
            root.row-menu(root.row-id);
        }
    }
}

// 分类行内菜单条（V1.1；设计稿 C2）。
//
// 宽度 = 侧栏宽，出现在该行下方；阴影 + 1px 边。
// 菜单项固定四个，**删除永远在最后**（`category_ops::menu_items` 的口径）。
// 「不可选」的判定不在这里做 —— 每个入口打开的浮层会自行校验。
component CategoryMenuStrip inherits Rectangle {
    in property <string> target-id: "";
    callback picked(string, string);
    callback closed();

    height: UiMetrics.list-row-height;
    background: Skin.layer-02;
    border-width: UiMetrics.hairline;
    border-color: Skin.primary-border;
    drop-shadow-color: #00000026;
    drop-shadow-blur: UiMetrics.space-8;
    drop-shadow-offset-y: UiMetrics.space-4;

    HorizontalLayout {
        x: UiMetrics.space-8;
        y: 0;
        width: parent.width - 2 * self.x;
        spacing: UiMetrics.space-4;
        alignment: start;

        TextButton {
            variant: 1;
            padding-x: UiMetrics.space-8;
            compact: true;
            caption: "新建子分类";
            activated => {
                root.picked("category-add-child", root.target-id);
            }
        }
        TextButton {
            variant: 1;
            padding-x: UiMetrics.space-8;
            compact: true;
            caption: "重命名";
            activated => {
                root.picked("category-rename", root.target-id);
            }
        }
        TextButton {
            variant: 1;
            padding-x: UiMetrics.space-8;
            compact: true;
            caption: "移动";
            activated => {
                root.picked("category-move", root.target-id);
            }
        }
        TextButton {
            variant: 3;
            padding-x: UiMetrics.space-8;
            compact: true;
            caption: "删除";
            activated => {
                root.picked("category-delete", root.target-id);
            }
        }
    }

    // 点击条外关闭。
    TouchArea {
        x: 0;
        y: parent.height;
        width: parent.width;
        height: UiMetrics.space-48;
        clicked => {
            root.closed();
        }
    }
}

// 分类操作浮层（V1.1；新建/重命名 + 删除去向 + 移动到分类）。
//
// 三态由 Rust 驱动（`category_ops`），界面只收集输入与单选：
// - `mode` 0=新建/重命名 1=删除 2=移动；
// - 「删除」态的确认按钮在**未选去向**时保持 disabled（`can-confirm` 由 Rust 给出），
//   界面**不推断**合法性（规格 R3 / 设计稿 C4）。
component CategoryActionDialog inherits Rectangle {
    in property <int> mode: 0;
    in property <string> title: "";
    in property <string> parent-line: "";
    in-out property <string> name-value: "";
    in property <string> error-line: "";
    in property <string> confirm-label: "保存";
    in property <bool> can-confirm: true;
    in property <string> note-line: "";
    in property <[ChoiceRow]> targets: [];
    in property <int> target-index: -1;
    callback cancelled();
    callback name-edited(string);
    callback target-picked(int);
    callback confirmed();

    background: transparent;

    Overlay {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        dismissed => {
            root.cancelled();
        }
    }

    panel := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: UiMetrics.modal-width-confirm;
        height: content.preferred-height + UiMetrics.space-24 * 2;
        background: Skin.layer-02;
        border-width: UiMetrics.hairline;
        border-color: Skin.border-strong;

        TouchArea { }

        content := VerticalLayout {
            x: UiMetrics.space-24;
            y: UiMetrics.space-24;
            width: parent.width - 2 * UiMetrics.space-24;
            spacing: UiMetrics.space-16;

            Text {
                text: root.title;
                font-size: UiMetrics.heading-font-size;
                font-weight: 600;
                color: Skin.text-primary;
                height: self.preferred-height;
            }

            // 父分类只读行（新建时默认 = 进入时选中的分类）。
            if root.mode != 2 : Text {
                text: root.parent-line;
                font-size: UiMetrics.label-font-size;
                color: Skin.text-secondary;
                height: self.preferred-height;
            }

            // 名称输入（新建 / 重命名）。
            if root.mode == 0 : TextField {
                text: root.name-value;
                label: "分类名称";
                edited(text) => {
                    root.name-edited(text);
                }
            }

            // 移动目标列表（设计稿 C5）。
            if root.mode == 2 : VerticalLayout {
                width: parent.width;
                spacing: UiMetrics.space-4;
                for row[index] in root.targets : RadioItem {
                    width: parent.width;
                    caption: row.name;
                    checked: root.target-index == index;
                    // 可选性由 Rust 给出（`enabled`），界面不解析文案。
                    enabled: row.enabled;
                    selected => {
                        root.target-picked(index);
                    }
                }
            }

            // 删除态的三个去向（必选；默认全空）。
            if root.mode == 1 : VerticalLayout {
                width: parent.width;
                spacing: UiMetrics.space-4;
                RadioItem {
                    width: parent.width;
                    caption: "移入另一分类…";
                    checked: root.target-index == 1;
                    selected => {
                        root.target-picked(1);
                    }
                }
                RadioItem {
                    width: parent.width;
                    caption: "一并移出书架（原始文件未改动）";
                    checked: root.target-index == 2;
                    selected => {
                        root.target-picked(2);
                    }
                }
                RadioItem {
                    width: parent.width;
                    caption: "移回根（未分类）";
                    checked: root.target-index == 3;
                    selected => {
                        root.target-picked(3);
                    }
                }
            }

            // 说明 / 错误（同父同名、循环移动等，均由 Rust 给出）。
            if root.note-line != "" : Text {
                text: root.note-line;
                font-size: UiMetrics.label-font-size;
                color: Skin.text-secondary;
                wrap: word-wrap;
                width: parent.width;
                height: self.preferred-height;
            }
            if root.error-line != "" : Text {
                text: root.error-line;
                font-size: UiMetrics.label-font-size;
                color: Skin.support-error;
                wrap: word-wrap;
                width: parent.width;
                height: self.preferred-height;
            }

            HorizontalLayout {
                width: parent.width;
                spacing: UiMetrics.space-8;
                alignment: end;
                TextButton {
                    caption: "取消";
                    variant: 1;
                    activated => {
                        root.cancelled();
                    }
                }
                TextButton {
                    caption: root.confirm-label;
                    // 0=Primary；未选去向 / 名称为空时禁用 —— 判定由 Rust 给（`can-confirm`）。
                    variant: 0;
                    enabled: root.can-confirm;
                    activated => {
                        root.confirmed();
                    }
                }
            }
        }
    }
}

// 导入归类浮层（V1.1；设计稿 C7）。
//
// 只在「多选文件 / 选目录」时出现（单文件导入直接归入当前分类）。
// 两个确认态按钮：「不归类，全部导入」/「按目录名归类并导入」；
// 「记住」勾选由 Rust 持久化（下次不再询问）。
// 预览行（目录名 + 书数）由 Rust 的 `batch_import::plan_import` 给出，
// 界面**不自己统计**。
component ImportOrganizeDialog inherits Rectangle {
    in property <string> title: "";
    in property <string> scope-line: "";
    in property <string> summary-line: "";
    in property <[OrganizeRow]> preview: [];
    in-out property <bool> remember: false;
    callback cancelled();
    callback remembered(bool);
    callback import-plain();
    callback import-organized();

    background: transparent;

    Overlay {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        dismissed => {
            root.cancelled();
        }
    }

    panel := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: UiMetrics.modal-width-confirm;
        height: content.preferred-height + UiMetrics.space-24 * 2;
        background: Skin.layer-02;
        border-width: UiMetrics.hairline;
        border-color: Skin.border-strong;

        TouchArea { }

        content := VerticalLayout {
            x: UiMetrics.space-24;
            y: UiMetrics.space-24;
            width: parent.width - 2 * UiMetrics.space-24;
            spacing: UiMetrics.space-16;

            Text {
                text: root.title;
                font-size: UiMetrics.heading-font-size;
                font-weight: 600;
                color: Skin.text-primary;
                height: self.preferred-height;
            }
            Text {
                text: root.scope-line;
                font-size: UiMetrics.label-font-size;
                color: Skin.text-secondary;
                wrap: word-wrap;
                width: parent.width;
                height: self.preferred-height;
            }
            Text {
                text: root.summary-line;
                font-size: UiMetrics.label-font-size;
                color: Skin.text-primary;
                wrap: word-wrap;
                width: parent.width;
                height: self.preferred-height;
            }

            // 预览：按目录名归类将新建的分类与各分类书数（Rust 给出）。
            if root.preview.length > 0 : VerticalLayout {
                width: parent.width;
                spacing: UiMetrics.space-4;
                for row[index] in root.preview : Rectangle {
                    width: parent.width;
                    height: UiMetrics.list-row-height;
                    // Slint 用 Math.mod（`%` 不是合法运算符）。
                    background: Math.mod(index, 2) == 0 ? Skin.layer-01 : transparent;
                    Text {
                        x: UiMetrics.space-8;
                        y: 0;
                        height: parent.height;
                        text: row.name;
                        font-size: UiMetrics.ui-font-size;
                        color: Skin.text-primary;
                        vertical-alignment: center;
                    }
                    Text {
                        x: parent.width - self.width - UiMetrics.space-8;
                        y: 0;
                        height: parent.height;
                        // count 由 Rust 给出（string），界面不做统计也不做转换。
                        text: row.count;
                        font-size: UiMetrics.caption-font-size;
                        color: Skin.text-secondary;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }
            }

            // 「记住我的选择」。
            Rectangle {
                width: parent.width;
                height: UiMetrics.space-24;
                background: transparent;
                Rectangle {
                    x: 0;
                    y: (parent.height - self.height) / 2;
                    width: UiMetrics.radio-size;
                    height: UiMetrics.radio-size;
                    border-radius: self.height / 2;
                    background: root.remember ? Skin.primary : Skin.field-01;
                    border-width: root.remember ? UiMetrics.space-4 : UiMetrics.hairline;
                    border-color: root.remember ? Skin.primary : Skin.control-track;
                }
                Text {
                    x: UiMetrics.radio-size + UiMetrics.space-8;
                    y: 0;
                    height: parent.height;
                    text: "记住我的选择，下次不再询问";
                    font-size: UiMetrics.label-font-size;
                    color: Skin.text-secondary;
                    vertical-alignment: center;
                }
                TouchArea {
                    clicked => {
                        root.remembered(!root.remember);
                    }
                }
            }

            VerticalLayout {
                width: parent.width;
                spacing: UiMetrics.space-8;
                TextButton {
                    width: parent.width;
                    caption: "按目录名归类并导入";
                    variant: 0;
                    activated => {
                        root.import-organized();
                    }
                }
                TextButton {
                    width: parent.width;
                    caption: "不归类，全部导入到当前分类";
                    variant: 1;
                    activated => {
                        root.import-plain();
                    }
                }
                TextButton {
                    width: parent.width;
                    caption: "取消";
                    variant: 2;
                    activated => {
                        root.cancelled();
                    }
                }
            }
        }
    }
}

// 阅读历史流水行（V1.1；设计稿 H1）。
//
// 纯渲染：时间（等宽）/ 书名 + 文件 / 位置 / 进入方式 tag / 行尾「…」。
// **不在此排序或格式化时间** —— 全部由 Rust 投影给出。
component HistoryRowView inherits Rectangle {
    in property <string> row-id: "";
    in property <string> book-id: "";
    in property <string> time-label: "";
    in property <string> book-title: "";
    in property <string> file-label: "";
    in property <string> position-label: "";
    in property <string> entry-kind-label: "";
    in property <int> entry-kind-tone: 0;
    callback open-book(string);
    callback row-menu(string);

    height: UiMetrics.history-row-height;
    background: transparent;

    // 时间（等宽；今天只到分钟）。
    Text {
        x: UiMetrics.space-16;
        y: 0;
        width: UiMetrics.history-time-width;
        height: parent.height;
        text: root.time-label;
        font-family: "monospace";
        font-size: UiMetrics.caption-font-size;
        color: Skin.text-secondary;
        vertical-alignment: center;
    }

    // 书名 + 文件名（静态分隔文本，非尺寸令牌）。
    Text {
        x: UiMetrics.space-16 + UiMetrics.history-time-width + UiMetrics.space-16;
        y: 0;
        width: parent.width - self.x - UiMetrics.history-position-width
            - UiMetrics.history-kind-width - UiMetrics.space-32;
        height: parent.height;
        text: root.book-title + " · " + root.file-label;
        font-size: UiMetrics.ui-font-size;
        color: Skin.text-primary;
        vertical-alignment: center;
        overflow: elide;
    }

    // 位置（打开时刻的章节与偏移）。
    Text {
        x: parent.width - UiMetrics.space-16 - UiMetrics.history-kind-width
            - UiMetrics.history-position-width;
        y: 0;
        width: UiMetrics.history-position-width;
        height: parent.height;
        text: root.position-label;
        font-size: UiMetrics.caption-font-size;
        color: Skin.text-secondary;
        horizontal-alignment: right;
        vertical-alignment: center;
    }

    // 进入方式 tag（语义色由 Rust 判定）。
    Tag {
        x: parent.width - UiMetrics.space-16 - UiMetrics.history-kind-width;
        y: (parent.height - UiMetrics.tag-height) / 2;
        text: root.entry-kind-label;
        tone: root.entry-kind-tone;
    }

    // 行尾「…」（打开这本书 / 清除这条）。
    IconButton {
        x: parent.width - UiMetrics.icon-button-size - UiMetrics.space-4;
        y: (parent.height - UiMetrics.icon-button-size) / 2;
        shape: Icons.more;
        activated => {
            root.row-menu(root.row-id);
        }
    }

    // 整行点击 = 打开这本书。
    TouchArea {
        clicked => {
            root.open-book(root.book-id);
        }
    }
}

// 阅读历史按书聚合的组头（V1.1；设计稿 H2）。
component HistoryGroupHeadView inherits Rectangle {
    in property <string> book-id: "";
    in property <string> book-title: "";
    in property <int> count: 0;
    in property <string> last-time-label: "";
    in property <bool> expanded: false;
    callback toggled(string);
    callback open-book(string);
    callback group-menu(string);

    height: UiMetrics.history-group-head-height;
    background: Skin.layer-01;

    // 展开箭头（`Path` 无 rotation，用两种既有形状切换）。
    Icon {
        x: UiMetrics.space-16;
        y: (parent.height - UiMetrics.tree-arrow-size) / 2;
        size: UiMetrics.tree-arrow-size;
        shape: root.expanded ? Icons.chevron-down : Icons.chevron-right;
        color: Skin.text-secondary;
    }

    Text {
        x: UiMetrics.space-16 + UiMetrics.tree-arrow-size + UiMetrics.space-8;
        y: 0;
        width: parent.width - self.x - UiMetrics.history-position-width
            - UiMetrics.icon-button-size - UiMetrics.space-32;
        height: parent.height;
        text: root.book-title;
        font-size: UiMetrics.ui-font-size;
        font-weight: 600;
        color: Skin.text-primary;
        vertical-alignment: center;
        overflow: elide;
    }

    // 次数 tag（Rust 给次数，界面只渲染）。
    Tag {
        x: parent.width - UiMetrics.space-16 - UiMetrics.history-position-width
            - UiMetrics.icon-button-size;
        y: (parent.height - UiMetrics.tag-height) / 2;
        text: root.count;
        tone: 1;
    }

    // 最近时间。
    Text {
        x: parent.width - UiMetrics.space-16 - UiMetrics.history-position-width;
        y: 0;
        width: UiMetrics.history-position-width;
        height: parent.height;
        text: root.last-time-label;
        font-family: "monospace";
        font-size: UiMetrics.caption-font-size;
        color: Skin.text-secondary;
        horizontal-alignment: right;
        vertical-alignment: center;
    }

    IconButton {
        x: parent.width - UiMetrics.icon-button-size - UiMetrics.space-4;
        y: (parent.height - UiMetrics.icon-button-size) / 2;
        shape: Icons.more;
        activated => {
            root.group-menu(root.book-id);
        }
    }

    TouchArea {
        clicked => {
            root.toggled(root.book-id);
        }
    }
}

component ShelfPage inherits Rectangle {
    // ---- 分类侧栏（V1.1）----
    in property <[CategoryRow]> categories: [];
    in property <bool> sidebar-visible: false;
    in property <string> selected-category-id: "";
    // 行内菜单（V1.1）：菜单挂在第几行（Rust 依据 id 算出下标；-1 = 未打开）。
    in property <string> category-menu-id: "";
    in property <int> category-menu-offset: -1;
    callback category-menu-picked(string, string);
    callback category-menu-close();
    // 分类操作对话框（新建 / 重命名 / 移动 / 删除）由 Rust 驱动。
    callback category-select(string);
    callback category-toggle(string);
    callback category-menu(string);
    callback category-add();
    // 批量导入（V1.1）：多选 / 选目录 + 「按目录名归类」询问。
    callback import-batch();
    // ---- 阅读历史（V1.1；设计稿 H1–H3）----
    in property <bool> history-mode: false;
    in property <[HistoryRow]> history-rows: [];
    in property <[HistoryGroupHead]> history-groups: [];
    in property <bool> history-grouped: false;
    in property <bool> history-empty: false;
    in property <string> history-empty-title: "";
    in property <string> history-empty-desc: "";
    in property <string> history-count: "";
    callback history-open(string);
    callback history-row-menu(string);
    callback history-group-toggle(string);
    callback history-group-menu(string);
    callback history-view-set(bool);
    // 「最近阅读」入口：进入 / 返回书架（Q5：不进分类侧栏）。
    callback history-toggle();
    // 「清空历史」：弹确认，确认后才删（设计稿 H3）。
    callback history-clear();
    in property <[BookRow]> rows: [];
    in property <bool> is-empty: false;
    in property <string> empty-title: "";
    in property <string> empty-desc: "";
    in property <[string]> empty-notes: [];
    // 0=表格 1=卡片
    in property <int> view: 0;
    in property <string> search: "";
    in property <string> sort-value: "";
    in property <string> count-label: "";
    in property <bool> notice: false;
    in property <string> notice-title: "";
    in property <string> notice-body: "";
    // 展开行级菜单的行下标（-1 = 未展开；由 Rust 依据 id 投影）。
    in property <int> menu-index: -1;
    // 排序序号（0=最近阅读 1=书名 2=导入时间；下拉高亮）。
    in property <int> sort-current: 0;
    // 排序下拉是否展开（纯界面局部状态）。
    private property <bool> sort-open: false;
    callback import-txt();
    callback search-edited(string);
    callback view-set(int);
    callback sort-cycle();
    callback sort-set(int);
    callback open-book(string);
    callback row-menu(int);
    callback row-action(string, string);
    callback relink-all();
    callback notice-dismiss();

    background: transparent;

    // ---- 分类侧栏（V1.1；宽度与断点由 Rust 投影，界面不自算）----
    // 层级靠「缩进 + 1px 分隔线」表达，不加卡片阴影（设计稿 §1）。
    if root.sidebar-visible : Rectangle {
        x: 0;
        y: 0;
        width: UiMetrics.sidebar-width;
        height: parent.height;
        background: Skin.layer-01;

        // 侧栏头（标题 + 新建）。
        // 宽度按「侧栏宽 - 左右固定留白 - 按钮槽」给出：不用 `parent.width - self.width`
        // （那会让 Text 宽度依赖自身 preferred-width，而父宽又含它 → 绑定循环，实测报错）。
        Text {
            x: UiMetrics.space-16;
            y: 0;
            width: UiMetrics.sidebar-width - UiMetrics.space-16 * 2
                - UiMetrics.icon-button-size - UiMetrics.space-8;
            height: UiMetrics.sidebar-head-height;
            text: "分类";
            font-size: UiMetrics.ui-font-size;
            font-weight: 600;
            color: Skin.text-primary;
            vertical-alignment: center;
            overflow: elide;
        }
        IconButton {
            x: parent.width - UiMetrics.icon-button-size - UiMetrics.space-8;
            y: (UiMetrics.sidebar-head-height - UiMetrics.icon-button-size) / 2;
            shape: Icons.info;
            tip-below: true;
            // 语义（新建）由 Rust 的可访问名称给出；此处只转发动作。
            activated => {
                root.category-add();
            }
        }

        // 树区（可滚动；行高与缩进全走 UiMetrics）。
        Flickable {
            x: 0;
            y: UiMetrics.sidebar-head-height;
            width: parent.width;
            height: parent.height - UiMetrics.sidebar-head-height;
            viewport-height: root.categories.length * UiMetrics.sidebar-row-height;
            viewport-y: clamp(0px, self.height - self.viewport-height, self.y);

            for row[index] in root.categories : CategoryRowView {
                x: 0;
                y: index * UiMetrics.sidebar-row-height;
                width: parent.width;
                row-id: row.id;
                row-name: row.name;
                row-depth: row.depth;
                direct-count: row.direct-count;
                total-count: row.total-count;
                has-children: row.has-children;
                expanded: row.expanded;
                selected: row.selected;
                move-blocked: row.move-blocked;
                virtual-row: row.virtual-row;
                row-kind: row.kind;
                row-clicked(id) => {
                    root.category-select(id);
                }
                toggle(id) => {
                    root.category-toggle(id);
                }
                row-menu(id) => {
                    root.category-menu(id);
                }
            }
            ScrollBar {
                x: parent.width - UiMetrics.scrollbar-gutter;
                y: 0;
                height: parent.height;
                ratio: root.categories.length == 0 ? 0
                    : (parent.height / (root.categories.length * UiMetrics.sidebar-row-height));
                handle-ratio: clamp(0.1, 1, self.ratio);
            }
        }

        // 行内菜单条（V1.1；打开的分类 id 由 Rust 给出，空串 = 未打开）。
        if root.category-menu-id != "" : CategoryMenuStrip {
            x: 0;
            y: UiMetrics.sidebar-head-height
                + root.category-menu-offset * UiMetrics.sidebar-row-height
                + UiMetrics.sidebar-row-height;
            width: parent.width;
            target-id: root.category-menu-id;
            picked(action, id) => {
                root.category-menu-picked(action, id);
            }
            closed => {
                root.category-menu-close();
            }
        }

        // 右侧 1px 分隔线。
        Rectangle {
            x: parent.width - UiMetrics.hairline;
            y: 0;
            width: UiMetrics.hairline;
            height: parent.height;
            background: Skin.border-subtle;
        }
    }

    // ---- 阅读历史视图（V1.1；设计稿 H1–H3）----
    // 与书架列表**互斥**：进入历史时不显示分类侧栏（Q5 裁定）。
    if root.history-mode : Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: transparent;

        // 页头（标题 + 计数 + 视图切换 + 清空）。
        Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: UiMetrics.page-header-height;
            background: transparent;

            Text {
                x: UiMetrics.space-16;
                y: 0;
                width: parent.width / 2;
                height: parent.height;
                text: "最近阅读";
                font-size: UiMetrics.title-font-size;
                font-weight: 600;
                color: Skin.text-primary;
                vertical-alignment: center;
            }
            Text {
                x: parent.width / 2;
                y: 0;
                width: parent.width / 4;
                height: parent.height;
                text: root.history-count;
                font-size: UiMetrics.label-font-size;
                color: Skin.text-secondary;
                vertical-alignment: center;
            }
            // 「清空历史」：**先弹确认**（H3），确认后才删 —— 直接删是数据事故。
            TextButton {
                x: parent.width - UiMetrics.space-16 - UiMetrics.button-height-compact
                    - UiMetrics.space-8 - UiMetrics.button-height-compact;
                y: (parent.height - UiMetrics.button-height-compact) / 2;
                variant: 3;
                compact: true;
                caption: "清空历史";
                enabled: !root.history-empty;
                activated => {
                    root.history-clear();
                }
            }
            TextButton {
                x: parent.width - UiMetrics.space-16 - UiMetrics.button-height-compact;
                y: (parent.height - UiMetrics.button-height-compact) / 2;
                variant: 1;
                compact: true;
                caption: root.history-grouped ? "按时间" : "按书聚合";
                activated => {
                    root.history-view-set(!root.history-grouped);
                }
            }
        }

        // 流水视图（H1）或按书聚合视图（H2）。
        if root.history-grouped : Flickable {
            x: 0;
            y: UiMetrics.page-header-height;
            width: parent.width;
            height: parent.height - UiMetrics.page-header-height;
            viewport-width: self.width;
            viewport-height: root.history-groups.length * UiMetrics.history-group-head-height;
            interactive: self.viewport-height > self.height;

            for group[index] in root.history-groups : HistoryGroupHeadView {
                x: 0;
                y: index * UiMetrics.history-group-head-height;
                width: parent.width;
                book-id: group.book-id;
                book-title: group.book-title;
                count: group.count;
                last-time-label: group.last-time-label;
                expanded: group.expanded;
                toggled(id) => {
                    root.history-group-toggle(id);
                }
                group-menu(id) => {
                    root.history-group-menu(id);
                }
            }
        }
        if !root.history-grouped : Flickable {
            x: 0;
            y: UiMetrics.page-header-height;
            width: parent.width;
            height: parent.height - UiMetrics.page-header-height;
            viewport-width: self.width;
            viewport-height: root.history-rows.length * UiMetrics.history-row-height;
            interactive: self.viewport-height > self.height;

            for row[index] in root.history-rows : HistoryRowView {
                x: 0;
                y: index * UiMetrics.history-row-height;
                width: parent.width;
                row-id: row.id;
                book-id: row.book-id;
                time-label: row.time-label;
                book-title: row.book-title;
                file-label: row.file-label;
                position-label: row.position-label;
                entry-kind-label: row.entry-kind-label;
                entry-kind-tone: row.entry-kind-tone;
                open-book(id) => {
                    root.history-open(id);
                }
                row-menu(id) => {
                    root.history-row-menu(id);
                }
            }
        }

        // 空态（设计稿 H1 固定文案；文案由 Rust 给出）。
        if root.history-empty : EmptyState {
            x: 0;
            y: UiMetrics.page-header-height;
            width: parent.width;
            height: parent.height - UiMetrics.page-header-height;
            shape: Icons.book;
            title: root.history-empty-title;
            description: root.history-empty-desc;
            notes: [];
            action-label: "";
        }
    }

    // 列可见性（§2.5 断点：窗口 < 960 隐藏「最近阅读」列）。
    // 紧凑档（<720）：设计 §2.5 规定「书架切卡片视图」——
    // 表格的固定列（状态/进度/最近/操作，合计约 40 个 em）会把书名列压到极窄，
    // 文字反复换行后溢出行容器被裁，表现为「字只显示一半」（主人 Windows 11 窄窗反馈）。
    private property <bool> tight: root.width < UiMetrics.breakpoint-tight;
    private property <bool> table-visible: !root.tight;
    private property <bool> recent-visible: root.width >= UiMetrics.breakpoint-compact;
    // 列表区起始 y（页头 80 + 可选通知条 96）。
    private property <length> list-top: UiMetrics.page-header-height + (root.notice ? UiMetrics.space-48 * 2 : 0px);
    // 侧栏可见时列表区整体右移并收窄（V1.1）。
    private property <length> list-left: root.sidebar-visible ? UiMetrics.sidebar-width : 0px;
    // 宽度由列表区自身给出（`private property` 内不可引用 `parent`）。
    private property <length> list-width: root.width - root.list-left;
    // 表格列位置（从右向左排布，右侧固定宽列）。
    private property <length> col-actions-x: root.list-width - UiMetrics.space-16 - UiMetrics.column-actions-width;
    private property <length> col-recent-x: root.col-actions-x - (root.recent-visible ? UiMetrics.column-recent-width : 0px);
    private property <length> col-progress-x: root.col-recent-x - UiMetrics.column-progress-width;
    private property <length> col-status-x: root.col-progress-x - UiMetrics.column-status-width;
    // 卡片模式菜单条的可用右边界（可视区内；右侧留出滚动条与页边距）。
    private property <length> cards-menu-max-x: root.list-width - UiMetrics.scrollbar-gutter - 2 * UiMetrics.space-16;
    // 卡片列数（3 / 2 / 1）。
    private property <int> card-columns: root.list-width >= (UiMetrics.card-width * 3 + UiMetrics.space-32 + UiMetrics.space-32) ? 3 : (root.list-width >= (UiMetrics.card-width * 2 + UiMetrics.space-16 + UiMetrics.space-32) ? 2 : 1);
    private property <length> card-gap: UiMetrics.space-16;
    private property <length> cards-height: Math.floor((root.rows.length + root.card-columns - 1) / root.card-columns) * (UiMetrics.card-height + root.card-gap) + root.card-gap + (root.menu-index >= 0 ? UiMetrics.list-row-height + UiMetrics.space-4 : 0px);
    private property <length> table-height: root.rows.length * UiMetrics.table-row-height + (root.menu-index >= 0 ? UiMetrics.list-row-height : 0px) + UiMetrics.space-16;

    // ---- S4：失效源文件通知（宽 = 内容区）----
    if root.notice : InlineNotice {
        x: root.list-left + UiMetrics.space-16;
        y: UiMetrics.page-header-height;
        width: root.list-width - 2 * UiMetrics.space-16;
        height: UiMetrics.space-48 * 2;
        tone: 4;
        title: root.notice-title;
        body: root.notice-body;
        action-label: "全部重新关联…";
        activated => {
            root.relink-all();
        }
        dismissed => {
            root.notice-dismiss();
        }
    }

    // ---- 列表区（表格 / 卡片；可滚动）----
    list-view := Flickable {
        visible: !root.is-empty;
        x: root.list-left;
        y: root.list-top;
        width: root.list-width;
        height: parent.height - root.list-top;
        viewport-width: self.width;
        viewport-height: root.view == 0 ? root.table-height + UiMetrics.table-header-height : root.cards-height;
        interactive: self.viewport-height > self.height;

        // ---- S1：表格视图 ----
        if root.view == 0 && root.table-visible : Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: root.table-height + UiMetrics.table-header-height;
            background: transparent;

            // 表头（40）：列标题为结构性文案。
            Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: UiMetrics.table-header-height;
                background: Skin.layer-01;

                Text {
                    x: UiMetrics.space-16;
                    y: 0;
                    width: root.col-status-x - UiMetrics.space-16 - UiMetrics.space-16;
                    height: parent.height;
                    text: "书名 / 文件";
                    font-size: UiMetrics.caption-font-size;
                    color: Skin.text-secondary;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Text {
                    x: root.col-status-x;
                    y: 0;
                    width: UiMetrics.column-status-width;
                    height: parent.height;
                    text: "状态";
                    font-size: UiMetrics.caption-font-size;
                    color: Skin.text-secondary;
                    vertical-alignment: center;
                }
                Text {
                    x: root.col-progress-x;
                    y: 0;
                    width: UiMetrics.column-progress-width;
                    height: parent.height;
                    text: "进度";
                    font-size: UiMetrics.caption-font-size;
                    color: Skin.text-secondary;
                    vertical-alignment: center;
                }
                Text {
                    x: root.col-recent-x;
                    y: 0;
                    width: UiMetrics.column-recent-width;
                    height: parent.height;
                    text: "最近阅读";
                    font-size: UiMetrics.caption-font-size;
                    color: Skin.text-secondary;
                    vertical-alignment: center;
                    visible: root.recent-visible;
                }
                Text {
                    x: root.col-actions-x;
                    y: 0;
                    width: UiMetrics.column-actions-width;
                    height: parent.height;
                    text: "操作";
                    font-size: UiMetrics.caption-font-size;
                    color: Skin.text-secondary;
                    vertical-alignment: center;
                    visible: root.width >= UiMetrics.breakpoint-narrow;
                }
            }

            // 行（48；整行可点 = 打开阅读；行尾「更多」= 行级动作）。
            for row[i] in root.rows : Rectangle {
                x: 0;
                y: UiMetrics.table-header-height + i * UiMetrics.table-row-height + (root.menu-index >= 0 && i > root.menu-index ? UiMetrics.list-row-height : 0px);
                row-area := TouchArea {
                    // 单击行体即打开阅读；行内按钮声明在其之后（上层），
                    // 因此点「…」/「继续阅读」不会误触（真实缺陷回归）。
                    clicked => {
                        root.open-book(row.id);
                    }
                }
                width: parent.width;
                height: UiMetrics.table-row-height;
                background: row-area.has-hover ? Skin.layer-01 : (root.menu-index == i ? Skin.primary-soft : transparent);
                if i == root.menu-index : RowMenuStrip {
                    x: 0;
                    y: parent.height;
                    width: parent.width;
                    picked(action) => {
                        if (action == "close") {
                            root.row-menu(-2);
                        } else {
                            root.row-action(action, row.id);
                        }
                    }
                }
                accessible-role: list-item;
                accessible-label: row.title;

                Rectangle {
                    x: UiMetrics.space-16;
                    y: parent.height - self.height;
                    width: parent.width - 2 * UiMetrics.space-16;
                    height: UiMetrics.hairline;
                    background: Skin.border-subtle;
                }

                // 书名 + 副标题：**显式高度 + 垂直居中**。
                // 不设 height 时 Slint 取自身度量高度，窄窗下换行会溢出 48 高的行容器并被裁，
                // 表现为「字只显示一半」（主人反馈，Windows 11 窄窗复现）。
                // overflow: elide 保证不换行、不切字，超长以省略号收尾。
                Text {
                    x: UiMetrics.space-16;
                    y: UiMetrics.space-4;
                    width: root.col-status-x - 2 * UiMetrics.space-16;
                    height: UiMetrics.space-16 + UiMetrics.space-4;
                    text: row.title;
                    font-size: UiMetrics.ui-font-size;
                    font-weight: 500;
                    color: row.can-open ? Skin.text-primary : Skin.text-disabled;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Text {
                    x: UiMetrics.space-16;
                    y: UiMetrics.space-4 + UiMetrics.space-16 + UiMetrics.space-2;
                    width: root.col-status-x - 2 * UiMetrics.space-16;
                    height: UiMetrics.mono-font-size + UiMetrics.space-4;
                    text: row.meta;
                    font-size: UiMetrics.mono-font-size;
                    font-family: "monospace";
                    color: Skin.text-placeholder;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Tag {
                    x: root.col-status-x;
                    y: (parent.height - self.height) / 2;
                    tone: row.status-tone;
                    text: row.status;
                }
                // 进度：文本 11 + 2 像素 进度条。
                Text {
                    x: root.col-progress-x;
                    y: UiMetrics.space-8;
                    width: UiMetrics.column-progress-width - UiMetrics.space-16;
                    text: row.progress;
                    font-size: UiMetrics.tag-font-size;
                    // 显式高度 + 垂直居中：窄窗下不设高度会溢出行容器被裁，字只显示一半。
                    height: (UiMetrics.tag-font-size) + UiMetrics.space-4;
                    vertical-alignment: center;
                    color: Skin.text-secondary;
                    overflow: elide;
                }
                Rectangle {
                    x: root.col-progress-x;
                    y: parent.height - UiMetrics.space-12;
                    width: UiMetrics.column-progress-width - UiMetrics.space-16;
                    height: UiMetrics.progress-bar-height;
                    background: Skin.control-track;

                    Rectangle {
                        x: 0;
                        y: 0;
                        width: parent.width * min(1000, max(0, row.percent)) / 1000;
                        height: parent.height;
                        background: Skin.primary;
                    }
                }
                Text {
                    x: root.col-recent-x;
                    y: 0;
                    width: UiMetrics.column-recent-width;
                    height: parent.height;
                    text: row.recent;
                    font-size: UiMetrics.label-font-size;
                    color: Skin.text-secondary;
                    vertical-alignment: center;
                    overflow: elide;
                    visible: root.recent-visible;
                }
                row-open-btn := IconButton {
                    x: root.col-actions-x;
                    y: (parent.height - self.height) / 2;
                    compact: true;
                    caption: row.needs-relink ? "重新关联" : "继续阅读";
                    selected: false;
                    shape: row.needs-relink ? Icons.error : Icons.play;
                    filled: !row.needs-relink;
                    activated => {
                        if (row.needs-relink) {
                            root.row-action("relink", row.id);
                        } else {
                            root.open-book(row.id);
                        }
                    }
                }
                IconButton {
                    x: row-open-btn.x + row-open-btn.width + UiMetrics.space-4;
                    y: (parent.height - self.height) / 2;
                    compact: true;
                    caption: "更多操作";
                    shape: Icons.more;
                    activated => {
                        root.row-menu(i);
                    }
                }

            }

        }

        // ---- S2：卡片视图 ----
        if root.view == 1 : Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: root.cards-height;
            background: transparent;

            for row[i] in root.rows : Rectangle {
                // 注意：Slint 的 `/` 对整数是**浮点**除法，网格下标必须显式取整
                // （否则卡片会单列堆叠、逐张盖住 —— 真实缺陷回归）。
                x: UiMetrics.space-16 + (i - Math.floor(i / root.card-columns) * root.card-columns) * (UiMetrics.card-width + root.card-gap);
                // 卡片模式下菜单条只出现在卡片下方（与列表模式互不影响）；
                // 最右一列会**左对齐夹紧**，避免按钮条超出可视区（真实缺陷回归）。
                if i == root.menu-index : RowMenuStrip {
                    x: min(0px, root.cards-menu-max-x - self.width - (i - Math.floor(i / root.card-columns) * root.card-columns) * (UiMetrics.card-width + root.card-gap));
                    y: UiMetrics.card-height + UiMetrics.space-4;
                    width: min(UiMetrics.card-width, root.cards-menu-max-x);
                    dense: true;
                    picked(action) => {
                        if (action == "close") {
                            root.row-menu(-2);
                        } else {
                            root.row-action(action, row.id);
                        }
                    }
                }
                card-area := TouchArea {
                    // 单击卡片体即打开阅读；卡片内按钮在上层，不会被抢。
                    clicked => {
                        root.open-book(row.id);
                    }
                }
                y: UiMetrics.space-16 + Math.floor(i / root.card-columns) * (UiMetrics.card-height + root.card-gap);
                width: UiMetrics.card-width;
                height: UiMetrics.card-height;
                background: Skin.layer-02;
                border-width: UiMetrics.hairline;
                border-color: row.needs-relink ? Skin.support-error : Skin.border-subtle;
                accessible-role: list-item;
                accessible-label: row.title;

                // 封面占位（本地派生：主色底 + 首字）。
                Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: UiMetrics.space-16;
                    width: UiMetrics.cover-size;
                    height: UiMetrics.cover-size;
                    background: row.needs-relink ? Skin.error-soft : Skin.cover-bg;
                    border-width: UiMetrics.hairline;
                    border-color: Skin.border-subtle;

                    Text {
                        x: 0;
                        y: 0;
                        width: parent.width;
                        height: parent.height;
                        text: row.initial;
                        font-size: UiMetrics.cover-font-size;
                        font-weight: 600;
                        color: row.needs-relink ? Skin.support-error : Skin.primary-strong;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Text {
                    x: UiMetrics.space-16;
                    y: UiMetrics.space-16 + UiMetrics.cover-size + UiMetrics.space-12;
                    width: parent.width - 2 * UiMetrics.space-16;
                    text: row.title;
                    font-size: UiMetrics.card-title-font-size;
                    font-weight: 600;
                    color: Skin.text-primary;
                    overflow: elide;
                }
                Tag {
                    x: UiMetrics.space-16;
                    y: UiMetrics.space-16 + UiMetrics.cover-size + UiMetrics.space-12 + UiMetrics.space-24 + UiMetrics.space-4;
                    tone: row.status-tone;
                    text: row.status;
                }
                Text {
                    x: UiMetrics.space-16;
                    y: UiMetrics.space-16 + UiMetrics.cover-size + UiMetrics.space-12 + UiMetrics.space-24 + UiMetrics.space-4;
                    width: parent.width - 2 * UiMetrics.space-16;
                    height: UiMetrics.tag-height;
                    text: (row.percent / 10) + "%";
                    font-size: UiMetrics.mono-font-size;
                    font-family: "monospace";
                    color: Skin.text-secondary;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
                Text {
                    x: UiMetrics.space-16;
                    y: UiMetrics.space-16 + UiMetrics.cover-size + UiMetrics.space-12 + UiMetrics.space-24 + UiMetrics.space-4 + UiMetrics.tag-height + UiMetrics.space-4;
                    width: parent.width - 2 * UiMetrics.space-16;
                    text: row.progress;
                    font-size: UiMetrics.tag-font-size;
                    color: Skin.text-secondary;
                    overflow: elide;
                }
                Rectangle {
                    x: UiMetrics.space-16;
                    y: UiMetrics.space-16 + UiMetrics.cover-size + UiMetrics.space-12 + UiMetrics.space-24 + UiMetrics.space-4 + UiMetrics.tag-height + UiMetrics.space-4 + UiMetrics.space-16 + UiMetrics.space-4;
                    width: parent.width - 2 * UiMetrics.space-16;
                    height: UiMetrics.progress-bar-height;
                    background: Skin.control-track;

                    Rectangle {
                        x: 0;
                        y: 0;
                        width: parent.width * min(1000, max(0, row.percent)) / 1000;
                        height: parent.height;
                        background: row.needs-relink ? Skin.support-error : Skin.primary;
                    }
                }
                TextButton {
                    x: UiMetrics.space-16;
                    y: UiMetrics.space-16 + UiMetrics.cover-size + UiMetrics.space-12 + UiMetrics.space-24 + UiMetrics.space-4 + UiMetrics.tag-height + UiMetrics.space-4 + UiMetrics.space-16 + UiMetrics.space-4 + UiMetrics.progress-bar-height + UiMetrics.space-8;
                    width: parent.width - 2 * UiMetrics.space-16 - UiMetrics.icon-button-compact-size - UiMetrics.space-8;
                    compact: true;
                    variant: row.needs-relink ? 1 : 0;
                    caption: row.needs-relink ? "重新关联" : "继续阅读";
                    activated => {
                        if (row.needs-relink) {
                            root.row-action("relink", row.id);
                        } else {
                            root.open-book(row.id);
                        }
                    }
                }
                IconButton {
                    x: parent.width - UiMetrics.space-16 - self.width;
                    y: UiMetrics.space-16 + UiMetrics.cover-size + UiMetrics.space-12 + UiMetrics.space-24 + UiMetrics.space-4 + UiMetrics.tag-height + UiMetrics.space-4 + UiMetrics.space-16 + UiMetrics.space-4 + UiMetrics.progress-bar-height + UiMetrics.space-8;
                    compact: true;
                    caption: "更多操作";
                    shape: Icons.more;
                    activated => {
                        root.row-menu(i);
                    }
                }
            }
        }
    }

    // 列表区滚动条（宽 8）。
    ScrollBar {
        visible: !root.is-empty;
        x: parent.width - UiMetrics.scrollbar-gutter - self.width;
        y: root.list-top + UiMetrics.space-8;
        height: parent.height - root.list-top - 2 * UiMetrics.space-8;
        ratio: list-view.viewport-y / max(UiMetrics.hairline, list-view.viewport-height - list-view.height);
        handle-ratio: min(1, list-view.height / max(UiMetrics.hairline, list-view.viewport-height));
        seek(ratio) => {
            list-view.viewport-y = max(0px, ratio * (list-view.viewport-height - list-view.height));
        }
    }

    // ---- S3：空态 ----
    if root.is-empty : EmptyState {
        x: root.list-left;
        y: UiMetrics.page-header-height;
        width: root.list-width;
        height: parent.height - UiMetrics.page-header-height;
        shape: Icons.book;
        title: root.empty-title;
        description: root.empty-desc;
        notes: root.empty-notes;
        action-label: "导入 TXT…";
        activated => {
            root.import-txt();
        }
    }

    // ---- 页头（80）：标题 24/600 + 计数 Tag；右侧 搜索 · 视图 · 排序 · 主按钮 ----
    // 说明：页头在源码顺序上位于列表之后 —— 这样排序字段的行内浮层不会被表格遮住。
    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: UiMetrics.page-header-height;
        background: transparent;

        Text {
            x: UiMetrics.space-16;
            y: UiMetrics.space-16;
            text: "书架";
            font-size: UiMetrics.title-font-size;
            font-weight: 600;
            color: Skin.text-primary;
        }
        Tag {
            x: UiMetrics.space-16 + title-text.preferred-width + UiMetrics.space-12;
            y: UiMetrics.space-16 + UiMetrics.space-8;
            tone: 0;
            text: root.count-label;
        }
        title-text := Text {
            x: 0px - parent.width;
            y: 0px - parent.height;
            text: "书架";
            font-size: UiMetrics.title-font-size;
            font-weight: 600;
        }
        // 「批量导入」（V1.1）：多选文件 / 选目录，导入前询问是否按目录名归类。
        batch-btn := TextButton {
            x: parent.width - UiMetrics.space-16 - self.width;
            y: (parent.height - self.height) / 2;
            variant: 1;
            caption: "批量导入…";
            activated => {
                root.import-batch();
            }
        }
        import-btn := TextButton {
            x: batch-btn.x - UiMetrics.space-16 - self.width;
            y: (parent.height - self.height) / 2;
            variant: 0;
            caption: "导入 TXT…";
            activated => {
                root.import-txt();
            }
        }
        // 「最近阅读」（V1.1；Q5 裁定：**独立菜单项**，不在分类侧栏）。
        history-btn := TextButton {
            x: import-btn.x - UiMetrics.space-16 - self.width;
            y: (parent.height - self.height) / 2;
            variant: root.history-mode ? 0 : 1;
            caption: root.history-mode ? "返回书架" : "最近阅读";
            activated => {
                root.history-toggle();
            }
        }
        sort-field := Rectangle {
            x: import-btn.x - UiMetrics.space-16 - self.width;
            y: (parent.height - self.height) / 2;
            width: UiMetrics.sort-field-width;
            height: UiMetrics.button-height-compact;
            background: Skin.field-01;
            border-width: UiMetrics.hairline;
            border-color: Skin.border-strong;

            Text {
                x: UiMetrics.space-8;
                y: (parent.height - self.height) / 2;
                width: parent.width - 3 * UiMetrics.space-8 - UiMetrics.icon-size;
                text: root.sort-value;
                font-size: UiMetrics.ui-font-size;
                color: Skin.text-primary;
                vertical-alignment: center;
                overflow: elide;
            }
            Icon {
                x: parent.width - UiMetrics.space-8 - self.width;
                y: (parent.height - self.height) / 2;
                shape: Icons.chevron-down;
                size: UiMetrics.icon-size;
                color: Skin.text-secondary;
            }
            sort-area := TouchArea {
                clicked => {
                    root.sort-open = !root.sort-open;
                }
            }
        }
        IconButton {
            x: sort-field.x - UiMetrics.space-16 - self.width - UiMetrics.icon-button-size - UiMetrics.space-4;
            y: (parent.height - self.height) / 2;
            caption: "列表视图";
            shape: Icons.table;
            selected: root.view == 0;
            activated => {
                root.view-set(0);
            }
        }
        IconButton {
            x: sort-field.x - UiMetrics.space-16 - self.width;
            y: (parent.height - self.height) / 2;
            caption: "卡片视图";
            shape: Icons.cards;
            selected: root.view == 1;
            activated => {
                root.view-set(1);
            }
        }
        search-field := TextField {
            x: sort-field.x - UiMetrics.space-16 - UiMetrics.icon-button-size - UiMetrics.space-4 - UiMetrics.icon-button-size - UiMetrics.space-16 - self.width;
            y: (parent.height - self.height) / 2;
            width: UiMetrics.search-field-width;
            compact: true;
            leading-icon: true;
            text: root.search;
            placeholder: "搜索书名 / 文件";
            label: "搜索书架";
            edited(text) => {
                root.search-edited(text);
            }
        }
    }
    // 排序下拉（点击字段展开；点其他处或选中后收起）。
    if root.sort-open : TouchArea {
        clicked => {
            root.sort-open = false;
        }
    }
    if root.sort-open : Rectangle {
        x: sort-field.x;
        y: (UiMetrics.page-header-height - UiMetrics.button-height-compact) / 2 + UiMetrics.button-height-compact + UiMetrics.space-4;
        width: UiMetrics.sort-field-width + UiMetrics.space-48;
        height: 3 * UiMetrics.list-row-height + UiMetrics.space-8;
        background: Skin.layer-02;
        border-width: UiMetrics.hairline;
        border-color: Skin.border-strong;

        for option[index] in ["按最近阅读", "按书名", "按导入时间"] : Rectangle {
            x: 0;
            y: UiMetrics.space-4 + index * UiMetrics.list-row-height;
            width: parent.width;
            height: UiMetrics.list-row-height;
            background: index == root.sort-current ? Skin.primary-soft : transparent;

            Text {
                x: UiMetrics.space-12;
                y: 0;
                width: parent.width - 2 * UiMetrics.space-12;
                height: parent.height;
                text: option;
                font-size: UiMetrics.ui-font-size;
                color: index == root.sort-current ? Skin.primary : Skin.text-primary;
                vertical-alignment: center;
                overflow: elide;
            }
            TouchArea {
                clicked => {
                    root.sort-open = false;
                    root.sort-set(index);
                }
            }
        }
    }
}

// ---------------------------------------------------------------------------
// S5 – S9：阅读页（工具条 / 正文 / 进度条 / 目录 / 书签 / 沉浸）
// ---------------------------------------------------------------------------

component ReaderPage inherits Rectangle {
    in property <string> heading: "";
    in property <bool> toolbar-open: true;
    in property <bool> immersive: false;
    in property <bool> show-floating: false;
    in property <bool> gesture-mode: false;
    in property <[string]> page-lines: [];
    // ---- 全局背景图（V1.1；设计稿 B1–B3）----
    // `background-path` 由 Rust 注入（数据目录下的绝对路径）。
    in property <image> background-image;
    in property <bool> background-set: false;
    // 0=覆盖铺满 1=原始尺寸平铺 2=原始尺寸居中（FitMode 序号，Rust 给）。
    in property <int> background-fit: 0;
    // 遮罩 alpha（0–255；Rust 已从千分比换算，界面不再换算）。
    in property <int> background-scrim: 0;
    in property <length> line-pitch: 0px;
    in property <length> body-font-size: 0px;
    in property <string> body-font-family: "";
    in property <length> column-x: 0px;
    in property <length> column-y: 0px;
    in property <length> column-width: 0px;
    in property <length> column-height: 0px;
    in property <int> progress-permille: 0;
    in property <string> shortcut-prev: "";
    in property <string> shortcut-next: "";
    in property <string> shortcut-immersive: "";
    in property <bool> toc-open: false;
    in property <[TocRow]> toc-rows: [];
    in property <float> toc-ratio: 0;
    in property <float> toc-handle-ratio: 0.2;
    in property <string> toc-count: "";
    in property <string> toc-readout: "";
    in property <string> toc-search: "";
    in property <bool> marks-open: false;
    in property <[MarkRow]> mark-rows: [];
    in property <string> mark-count: "";
    in property <string> mark-readout: "";
    in property <string> rename-text: "";
    in property <string> mark-search: "";
    callback options-clicked();
    callback toolbar-toggle();
    callback immersive-toggle();
    callback prev-page();
    callback next-page();
    callback save-progress();
    callback progress-seek(float);
    callback zone-hover(bool);
    callback toc-toggle();
    callback toc-wheel(length);
    callback toc-seek(length, length);
    callback toc-search-edited(string);
    callback chapter-jump(string);
    callback marks-toggle();
    callback marks-scroll(int);
    callback mark-search-edited(string);
    callback mark-add();
    callback mark-select(string);
    callback mark-jump(string);
    callback mark-rename(string);
    callback mark-delete(string);
    callback mark-delete-confirm(string);
    callback mark-delete-cancel();
    callback rename-text-edited(string);
    callback overlay-click();
    callback key-input(string, bool);
    callback wheel-input(length, length);

    background: Skin.background;

    // ---- 全局阅读背景图（V1.1；设计稿 B1–B3）----
    //
    // 三层结构（图 + 遮罩 + 正文），声明在**工具条之前**，
    // 保证正文永远画在背景之上。
    //
    // 缩放口径由 `background-fit`（FitMode 序号）映射，**判定在 Rust**
    // （0=覆盖铺满 1=原始尺寸平铺 2=原始尺寸居中）；这里只按序号选
    // Slint 的三种 `image-fit` 值，不做缩放算法。
    if root.background-set : Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: transparent;

        Image {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            source: root.background-image;
            image-fit: root.background-fit == 0 ? cover
                : (root.background-fit == 1 ? preserve : contain);
            // 平铺时 Slint 不支持 repeat，故用 `preserve` 并由 Rust 预先
            // 在图片本身处理（本期限制：不支持平铺，退化为原始尺寸居中）。
            image-rendering: smooth;
        }

        // 遮罩层：保证正文可读（alpha 由 Rust 从千分比换算）。
        Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            // 遮罩颜色 + `opacity` 表达不透明度（Slint 无 alpha 乘法表达式）。
            // `background-scrim` 是 0–255 的 alpha（Rust 从千分比换算）。
            background: #000000;
            opacity: root.background-scrim / 255;
        }
    }

    // 工具条高度（沉浸态 0；收起态 0；紧凑档 40）。
    // 收起态仍保留一行高度（只放「展开工具条」按钮），避免窄窗下按钮压住正文；
    // 沉浸态为 0（沉浸是整体隐去两条栏）。
    private property <length> bar-h: root.immersive ? 0px : (root.toolbar-open ? (root.width >= UiMetrics.breakpoint-narrow ? UiMetrics.toolbar-height : UiMetrics.toolbar-height-compact) : UiMetrics.collapsed-toolbar-height);
    // 收起态：仅右上角一个「展开工具条」按钮（其余控件与标题不显示）。
    private property <bool> collapsed: !root.toolbar-open;

    // ---- S5：阅读工具条（左 3 图标 + 居中「书名 · 章节」+ 右 3 图标）----
    // 注意：工具条**不得** clip（否则按钮浮层提示会被自身裁掉下半截）。
    // 沉浸态**整块不渲染**：仅把高度归零不够——内部控件仍会按自身高度画在正文上
    // （主人反馈：沉浸后 6 个按钮依旧可见）。沉浸态改由顶部浮出工具条承载。
    if !root.immersive : Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: root.bar-h;
        // 收起态整行透明：只留右上角的「展开工具条」按钮，
        // 避免留下一条无用的灰条（主人反馈）。
        background: root.collapsed ? transparent : Skin.layer-01;

        if !root.collapsed : Rectangle {
            x: 0;
            y: parent.height - self.height;
            width: parent.width;
            height: UiMetrics.hairline;
            background: Skin.border-subtle;
        }
        // 左：目录 / 书签 / 选项。**绝对定位**：本代码库中布局的 horizontal-stretch
        // 实测不生效（工具条 6 个图标曾全部挤在左侧、中间标题宽度为 0 不渲染）。
        if !root.collapsed : HorizontalLayout {
            width: self.preferred-width;
            x: UiMetrics.space-8;
            y: 0;
            height: parent.height;
            spacing: UiMetrics.space-4;
            alignment: center;

            VerticalLayout {
                alignment: center;
                IconButton {
                    caption: "目录";
                    shape: Icons.toc;
                    selected: root.toc-open;
                    tip-below: true;
                    activated => {
                        root.toc-toggle();
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    caption: "书签";
                    shape: Icons.mark;
                    selected: root.marks-open;
                    tip-below: true;
                    activated => {
                        root.marks-toggle();
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    caption: "选项";
                    shape: Icons.options;
                    tip-below: true;
                    activated => {
                        root.options-clicked();
                    }
                }
            }
        }
        // 中：书名 · 章节（绝对居中 + 省略号；宽度上限给两侧按钮组留白）。
        if !root.collapsed : Text {
            width: min(self.preferred-width, parent.width - 2 * (UiMetrics.space-8 + 3 * UiMetrics.icon-button-size + 3 * UiMetrics.space-4 + UiMetrics.space-8));
            x: (parent.width - self.width) / 2;
            y: 0;
            height: parent.height;
            text: root.heading;
            font-size: UiMetrics.ui-font-size;
            color: Skin.text-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
        // 右：保存进度 / 沉浸 / 收起（绝对贴右）。
        if !root.collapsed : HorizontalLayout {
            width: self.preferred-width;
            x: parent.width - UiMetrics.space-8 - self.width;
            y: 0;
            height: parent.height;
            spacing: UiMetrics.space-4;
            alignment: center;
            VerticalLayout {
                alignment: center;
                IconButton {
                    caption: "保存进度";
                    shape: Icons.save;
                    tip-below: true;
                    activated => {
                        root.save-progress();
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    caption: "沉浸阅读";
                    shortcut: root.shortcut-immersive;
                    shape: Icons.expand;
                    tip-below: true;
                    activated => {
                        root.immersive-toggle();
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    // 模式切换按钮：展开态显示「向上收起」，收起态显示「向下展开」。
                    caption: root.toolbar-open ? "收起工具条" : "展开工具条";
                    shape: root.toolbar-open ? Icons.toolbar-collapse : Icons.toolbar-expand;
                    tip-below: true;
                    activated => {
                        root.toolbar-toggle();
                    }
                }
            }
        }
    }

    // ---- 正文（几何由 Rust 投影：正文列 = min(正文区宽, 40 × 字号) 居中）----
    Rectangle {
        x: root.column-x;
        y: root.column-y;
        width: root.column-width;
        height: root.column-height;
        background: transparent;
        clip: true;

        for line[index] in root.page-lines : Text {
            x: 0;
            y: index * root.line-pitch;
            width: parent.width;
            height: root.line-pitch;
            text: line;
            font-family: root.body-font-family;
            font-size: root.body-font-size;
            letter-spacing: 0px;
            color: Skin.reading-text;
            horizontal-alignment: left;
            vertical-alignment: center;
            wrap: no-wrap;
        }

        // 点击分区（手势模式左/右 1/3 翻页、中部收起工具条；按钮模式点中部收起工具条）
        // + 滚轮整页翻页（正文不出滚动条）。
        content-area := TouchArea {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;

            clicked => {
                reader-keys.focus();
                if (root.gesture-mode) {
                    if (self.mouse-x < self.width / 3) {
                        root.prev-page();
                    } else if (self.mouse-x > self.width * 2 / 3) {
                        root.next-page();
                    } else if (root.immersive) {
                        root.immersive-toggle();
                    } else {
                        root.toolbar-toggle();
                    }
                } else if (root.immersive) {
                    root.immersive-toggle();
                } else {
                    root.toolbar-toggle();
                }
            }

            scroll-event(event) => {
                root.wheel-input(event.delta-x, event.delta-y);
                accept
            }
        }
    }

    // 键盘翻页入口（真实按键通道）：只上报原始按键文本 + 「焦点是否不在本作用域上」。
    reader-keys := FocusScope {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;

        init => {
            self.focus();
        }

        key-pressed(event) => {
            root.key-input(event.text, !self.has-focus);
            reject
        }
    }

    // 收起态：右上角唯一的「展开工具条」按钮（其余控件隐藏，见上方条件元素）。
    // 沉浸态不显示（沉浸由顶部浮出工具条承载）。
    if root.collapsed && !root.immersive : IconButton {
        x: parent.width - UiMetrics.space-8 - self.width;
        y: (root.bar-h - self.height) / 2;
        caption: "展开工具条";
        shape: Icons.toolbar-expand;
        tip-below: true;
        activated => {
            root.toolbar-toggle();
        }
    }

    // ---- S5：阅读进度条（2 像素；hover 4 像素 并显示浮标；点击/拖拽跳转）----
    progress-bar := ProgressTrack {
        x: 0;
        y: parent.height - self.height;
        width: parent.width;
        permille: root.progress-permille;
        interactive: true;
        seek(ratio) => {
            root.progress-seek(ratio);
        }
    }
    if progress-bar.hovering : Rectangle {
        x: min(parent.width - self.width, max(0px, progress-bar.pointer-x - self.width / 2));
        y: parent.height - UiMetrics.progress-bar-hover-height - UiMetrics.space-32;
        width: bubble-text.preferred-width + UiMetrics.space-12;
        height: UiMetrics.space-24;
        background: Skin.toast-bg;
        border-radius: UiMetrics.toast-radius;
        opacity: 0.9;

        bubble-text := Text {
            text: "跳至 " + round(progress-bar.pointer-x / max(UiMetrics.hairline, root.width) * 100) + "%";
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            font-size: UiMetrics.caption-font-size;
            color: Skin.toast-text;
        }
    }

    // ---- 覆盖层：点击面板外关闭（O4）----
    if (root.toc-open || root.marks-open) : TouchArea {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        clicked => {
            root.overlay-click();
        }
    }

    // ---- S6：目录面板（覆盖正文区；内缩 24 水平 / 16 垂直）----
    if root.toc-open : Rectangle {
        x: UiMetrics.space-24;
        y: root.bar-h + UiMetrics.space-16;
        width: parent.width - 2 * UiMetrics.space-24;
        height: parent.height - root.bar-h - UiMetrics.progress-bar-height - 2 * UiMetrics.space-16;
        background: Skin.layer-02;
        border-width: UiMetrics.hairline;
        border-color: Skin.border-strong;
        clip: true;

        // 滚轮层：位于目录内容之下（声明的先后即叠放顺序）——行可点，滚轮在本层被消费。
        TouchArea {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;

            scroll-event(event) => {
                root.toc-wheel(event.delta-y);
                accept
            }
        }

        // 面板头 48：「目录」+ 计数 Tag + 搜索 260 + 关闭。
        Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: UiMetrics.panel-header-height;
            background: Skin.layer-01;

            HorizontalLayout {
                x: UiMetrics.space-16;
                y: 0;
                width: parent.width - 2 * UiMetrics.space-16;
                height: parent.height;
                spacing: UiMetrics.space-8;
                alignment: start;

                Text {
                    text: "目录";
                    font-size: UiMetrics.body-font-size;
                    font-weight: 600;
                    color: Skin.text-primary;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    alignment: center;
                    Tag {
                        tone: 1;
                        text: root.toc-count;
                    }
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                VerticalLayout {
                    alignment: center;
                    TextField {
                        width: UiMetrics.search-field-panel-width;
                        compact: true;
                        leading-icon: true;
                        text: root.toc-search;
                        placeholder: "按章节名过滤";
                        label: "搜索章节";
                        edited(text) => {
                            root.toc-search-edited(text);
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        compact: true;
                        caption: "关闭目录";
                        shape: Icons.close;
                        activated => {
                            root.toc-toggle();
                        }
                    }
                }
            }
        }

        // 行（40）：序号 mono + 章节名 + 偏移量 mono；整行可点（跳转）。
        for row[i] in root.toc-rows : Rectangle {
            x: UiMetrics.space-8;
            toc-row-area := TouchArea {
                clicked => {
                    root.chapter-jump(row.sequence);
                }
            }
            y: UiMetrics.panel-header-height + i * UiMetrics.list-row-height;
            width: parent.width - UiMetrics.space-8 - UiMetrics.scrollbar-width - UiMetrics.space-8;
            height: UiMetrics.list-row-height;
            background: row.current ? Skin.primary-soft : (toc-row-area.has-hover ? Skin.layer-01 : transparent);
            accessible-role: list-item;
            accessible-label: row.title;

            if row.current : Rectangle {
                x: 0;
                y: 0;
                width: UiMetrics.space-4 - UiMetrics.hairline;
                height: parent.height;
                background: Skin.primary;
            }
            Text {
                x: UiMetrics.space-12;
                y: 0;
                width: UiMetrics.space-48;
                height: parent.height;
                text: row.sequence;
                font-family: "monospace";
                font-size: UiMetrics.mono-font-size;
                color: row.current ? Skin.primary-strong : Skin.text-placeholder;
                vertical-alignment: center;
            }
            Text {
                x: UiMetrics.space-12 + UiMetrics.space-48;
                y: 0;
                width: parent.width - UiMetrics.space-12 - UiMetrics.space-48 - UiMetrics.space-48 * 2 - UiMetrics.space-16;
                height: parent.height;
                text: row.title;
                font-size: UiMetrics.label-font-size;
                font-weight: row.current ? 600 : 400;
                color: row.current ? Skin.primary-strong : Skin.text-primary;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                x: parent.width - UiMetrics.space-48 * 2;
                y: 0;
                width: UiMetrics.space-48 * 2 - UiMetrics.space-8;
                height: parent.height;
                text: row.meta;
                font-family: "monospace";
                font-size: UiMetrics.mono-font-size;
                color: Skin.text-placeholder;
                vertical-alignment: center;
            }
        }

        // 底部提示条 32：滚轮行为说明 + 位置读数。
        Rectangle {
            x: 0;
            y: parent.height - self.height;
            width: parent.width;
            height: UiMetrics.panel-hint-height;
            background: Skin.layer-01;

            Text {
                x: UiMetrics.space-16;
                y: 0;
                width: parent.width / 2;
                height: parent.height;
                text: "滚轮滚动目录 · 点击行跳转";
                font-size: UiMetrics.caption-font-size;
                color: Skin.text-placeholder;
                vertical-alignment: center;
            }
            Text {
                x: parent.width / 2;
                y: 0;
                width: parent.width / 2 - UiMetrics.space-16 - UiMetrics.scrollbar-width - UiMetrics.space-8;
                height: parent.height;
                text: root.toc-readout;
                font-family: "monospace";
                font-size: UiMetrics.mono-font-size;
                color: Skin.text-secondary;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }

        // 面板滚动条（8）。
        ScrollBar {
            x: parent.width - UiMetrics.scrollbar-gutter;
            y: UiMetrics.panel-header-height;
            height: parent.height - UiMetrics.panel-header-height - UiMetrics.panel-hint-height;
            ratio: root.toc-ratio;
            handle-ratio: root.toc-handle-ratio;
            seek(ratio) => {
                root.toc-seek(ratio * 1000 * UiMetrics.hairline, 1000 * UiMetrics.hairline);
            }
        }
    }

    // ---- S7：书签面板 ----
    if root.marks-open : Rectangle {
        x: UiMetrics.space-24;
        y: root.bar-h + UiMetrics.space-16;
        width: parent.width - 2 * UiMetrics.space-24;
        height: parent.height - root.bar-h - UiMetrics.progress-bar-height - 2 * UiMetrics.space-16;
        background: Skin.layer-02;
        border-width: UiMetrics.hairline;
        border-color: Skin.border-strong;
        clip: true;

        // 面板头 48：「书签」+ 计数 Tag + 搜索 + 唯一主按钮 + 关闭。
        Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: UiMetrics.panel-header-height;
            background: Skin.layer-01;

            HorizontalLayout {
                x: UiMetrics.space-16;
                y: 0;
                width: parent.width - 2 * UiMetrics.space-16;
                height: parent.height;
                spacing: UiMetrics.space-8;
                alignment: start;

                Text {
                    text: "书签";
                    font-size: UiMetrics.body-font-size;
                    font-weight: 600;
                    color: Skin.text-primary;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    alignment: center;
                    Tag {
                        tone: 1;
                        text: root.mark-count;
                    }
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                VerticalLayout {
                    alignment: center;
                    TextField {
                        width: UiMetrics.search-field-panel-width;
                        compact: true;
                        leading-icon: true;
                        text: root.mark-search;
                        placeholder: "按标题过滤";
                        label: "搜索书签";
                        edited(text) => {
                            root.mark-search-edited(text);
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    TextButton {
                        compact: true;
                        variant: 0;
                        caption: "在当前页新增书签";
                        activated => {
                            root.mark-add();
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        compact: true;
                        caption: "关闭书签";
                        shape: Icons.close;
                        activated => {
                            root.marks-toggle();
                        }
                    }
                }
            }
        }

        // 行（40）：章节读数 mono + 标题 + 位置 + 行尾图标（跳转 / 重命名 / 删除）。
        for row[i] in root.mark-rows : Rectangle {
            x: UiMetrics.space-8;
            mark-row-area := TouchArea {
                clicked => {
                    root.mark-select(row.id);
                }
                double-clicked => {
                    root.mark-jump(row.id);
                }
            }
            y: UiMetrics.panel-header-height + i * UiMetrics.list-row-height;
            width: parent.width - UiMetrics.space-8 - UiMetrics.scrollbar-width - UiMetrics.space-8;
            height: UiMetrics.list-row-height;
            background: row.selected ? Skin.primary-soft : (mark-row-area.has-hover ? Skin.layer-01 : transparent);
            accessible-role: list-item;
            accessible-label: row.title;

            if row.delete-pending : HorizontalLayout {
                x: UiMetrics.space-12;
                y: 0;
                width: parent.width - 2 * UiMetrics.space-12;
                spacing: UiMetrics.space-8;
                alignment: start;

                Text {
                    text: "删除这条书签？";
                    font-size: UiMetrics.label-font-size;
                    color: Skin.support-error;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                TextButton {
                    compact: true;
                    variant: 2;
                    caption: "取消";
                    activated => {
                        root.mark-delete-cancel();
                    }
                }
                TextButton {
                    compact: true;
                    variant: 3;
                    caption: "删除";
                    activated => {
                        root.mark-delete-confirm(row.id);
                    }
                }
            }
            if !row.delete-pending : HorizontalLayout {
                x: UiMetrics.space-12;
                y: 0;
                width: parent.width - 2 * UiMetrics.space-12;
                spacing: UiMetrics.space-8;
                alignment: start;

                Text {
                    width: UiMetrics.space-48 * 2;
                    text: row.chapter;
                    font-family: "monospace";
                    font-size: UiMetrics.mono-font-size;
                    color: Skin.text-placeholder;
                    vertical-alignment: center;
                }
                Text {
                    text: row.title;
                    font-size: UiMetrics.label-font-size;
                    font-weight: row.selected ? 600 : 400;
                    color: row.current-chapter ? Skin.primary-strong : Skin.text-primary;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                Text {
                    text: row.position-label;
                    font-family: "monospace";
                    font-size: UiMetrics.mono-font-size;
                    color: Skin.text-placeholder;
                    vertical-alignment: center;
                }
                IconButton {
                    compact: true;
                    caption: "跳转";
                    shape: Icons.forward;
                    activated => {
                        root.mark-jump(row.id);
                    }
                }
                IconButton {
                    compact: true;
                    caption: "重命名";
                    shape: Icons.options;
                    activated => {
                        root.mark-select(row.id);
                    }
                }
                IconButton {
                    compact: true;
                    caption: "删除";
                    shape: Icons.close;
                    danger: true;
                    activated => {
                        root.mark-delete(row.id);
                    }
                }
            }
        }

        // 重命名区（64）：选中项 + 输入框 + 「保存名称」。
        Rectangle {
            x: 0;
            y: parent.height - UiMetrics.panel-hint-height - UiMetrics.space-48 - UiMetrics.space-16;
            width: parent.width;
            height: UiMetrics.space-48 + UiMetrics.space-16;
            background: Skin.layer-01;

            rename-field := TextField {
                x: UiMetrics.space-16;
                y: UiMetrics.space-8;
                width: parent.width - 2 * UiMetrics.space-16 - UiMetrics.space-48 * 2 - UiMetrics.space-16;
                compact: true;
                text: root.rename-text;
                placeholder: "选中书签后输入新名称";
                label: "书签名称";
                edited(text) => {
                    root.rename-text-edited(text);
                }
            }
            TextButton {
                x: parent.width - UiMetrics.space-16 - self.width;
                y: UiMetrics.space-8;
                compact: true;
                variant: 1;
                caption: "保存名称";
                activated => {
                    root.mark-rename(root.rename-text);
                }
            }
        }

        // 底部提示条 32：滚轮说明 + 位置读数。
        Rectangle {
            x: 0;
            y: parent.height - self.height;
            width: parent.width;
            height: UiMetrics.panel-hint-height;
            background: Skin.layer-01;

            Text {
                x: UiMetrics.space-16;
                y: 0;
                width: parent.width / 2;
                height: parent.height;
                text: "单击选中 · 双击跳转 · 删除需二次确认";
                font-size: UiMetrics.caption-font-size;
                color: Skin.text-placeholder;
                vertical-alignment: center;
            }
            Text {
                x: parent.width / 2;
                y: 0;
                width: parent.width / 2 - UiMetrics.space-16 - UiMetrics.scrollbar-width - UiMetrics.space-8;
                height: parent.height;
                text: root.mark-readout;
                font-family: "monospace";
                font-size: UiMetrics.mono-font-size;
                color: Skin.text-secondary;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }

        ScrollBar {
            x: parent.width - UiMetrics.scrollbar-gutter;
            y: UiMetrics.panel-header-height;
            height: parent.height - UiMetrics.panel-header-height - UiMetrics.panel-hint-height - UiMetrics.space-48 - UiMetrics.space-16;
            ratio: 0;
            handle-ratio: min(1, (UiMetrics.list-row-height * 8) / max(UiMetrics.hairline, root.mark-rows.length * UiMetrics.list-row-height));
            seek(ratio) => {
                root.marks-scroll(round(ratio * 100) - 50);
            }
        }
    }

    // ---- S9：沉浸态（顶部悬停 → 浮出工具条；离开 1.5s 由 Rust 一次性定时器淡出）----
    if root.immersive : Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        background: transparent;

        zone := TouchArea {
            x: 0;
            y: 0;
            width: parent.width;
            height: root.show-floating ? UiMetrics.floating-toolbar-height : UiMetrics.space-24;

            changed has-hover => {
                root.zone-hover(self.has-hover);
            }
        }

        if root.show-floating : Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            // 设计 §5 S9：浮出工具条 40（不是常驻工具条的 48）。
            height: UiMetrics.floating-toolbar-height;

            Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                background: Skin.layer-01;
                opacity: 0.82;
            }
            Rectangle {
                x: 0;
                y: parent.height - self.height;
                width: parent.width;
                height: UiMetrics.hairline;
                background: Skin.border-subtle;
            }
            // 左 3 个：垂直居中（包裹布局）。
            HorizontalLayout {
                width: self.preferred-width;
                x: UiMetrics.space-8;
                y: 0;
                height: parent.height;
                spacing: UiMetrics.space-4;
                alignment: center;

                VerticalLayout {
                    alignment: center;
                    IconButton {
                        caption: "目录";
                        shape: Icons.toc;
                        activated => {
                            root.toc-toggle();
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        caption: "书签";
                        shape: Icons.mark;
                        activated => {
                            root.marks-toggle();
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        caption: "保存进度";
                        shape: Icons.save;
                        activated => {
                            root.save-progress();
                        }
                    }
                }
            }
            // 右 1 个「退出沉浸」：绝对贴右并垂直居中。
            HorizontalLayout {
                width: self.preferred-width;
                x: parent.width - UiMetrics.space-8 - self.width;
                y: 0;
                height: parent.height;
                spacing: UiMetrics.space-4;
                alignment: center;

                VerticalLayout {
                    alignment: center;
                    IconButton {
                        caption: "退出沉浸";
                        shortcut: root.shortcut-immersive;
                        shape: Icons.collapse;
                        activated => {
                            root.immersive-toggle();
                        }
                    }
                }
            }
        }
    }

    // 选项入口（S8：居中弹窗由 AppWindow 承载；此处只上报意图）。
}

// ---------------------------------------------------------------------------
// S10：设置（表单化：滑杆 / 开关 / 单选 / 循环字段 / 只读 / 动作行）
// ---------------------------------------------------------------------------

component SettingsPage inherits Rectangle {
    // 表单内容高度（像素；Rust 投影，与行高口径一致）。
    in property <length> content-height: 0px;
    // 滚动偏移与视口高度（Rust 持有）。
    in property <length> scroll-y: 0px;
    in property <length> viewport-height: 0px;
    callback scroll-by(length);
    callback scroll-to(float);
    // 说明块（kind 7）把**实测**渲染高度回报 Rust（2026-10-04 主人要求按内容定高）。
    // Rust 用它替换固定估算值并重算整页 `content_height`，避免宽度足够时下方留大片空白。
    callback note-height-changed(int, length);
    // 下拉框（选择型字段）状态与交互。
    in property <bool> select-open: false;
    in property <length> select-y: 0px;
    in property <string> select-key: "";
    in property <int> select-index: 0;
    in property <[string]> select-options: [];
    callback select-toggle(string);
    callback select-close();
    in property <[SettingsRow]> rows: [];
    in property <string> note: "";
    in property <string> data-path: "";
    callback cycle(string);
    callback set-int(string, int);
    callback set-text(string, string);
    callback set-index(string, int);
    callback toggle(string, bool);
    callback clear-index();
    callback clear-index-clicked();

    background: transparent;

    private property <length> label-width: UiMetrics.space-48 * 4 + UiMetrics.space-8;
    private property <length> control-x: root.label-width + UiMetrics.space-16;

    // ---- 数值行（kind 1）控件宽度的**自适应口径**（2026-10-04 修窄窗溢出）----
    //
    // 缺陷：滑杆与数值框原先都用**固定长度**（`search-field-width ± space-48*2`），
    // 右端合计约七百余像素；而内容区宽 = 窗口宽 - 2×留白，故窗口窄于约八百像素时
    // 数值框右端**溢出窗口**被裁切（在最小窗口宽度下实测溢出两百余像素）。
    // ⚠️ 本注释刻意不写带单位的尺寸值 —— `tests/layout_constants.rs` 会扫描 `.slint`
    // 全文（**含注释**）并拒绝除「零值」外的任何写死尺寸，同一坑已踩三次。
    //
    // 修法（单行夹紧，不换行）：把「可用宽度」按比例分给数值框与滑杆，
    // 数值框有**最小/最大宽度**，滑杆吃剩余量并**不小于最小宽度**。
    // 这样任何窗口宽度下右端都恰好落在内容区右边界内，不会溢出。
    private property <length> row-controls-right: root.width - UiMetrics.space-16;         // 控件区右界（留 16右边距）
    private property <length> row-controls-avail: max(0px, root.row-controls-right - root.control-x);

    // 数值框宽度：目标约可用宽度的 3/10，夹在 [96, 144]（96 ≈ 可显示 3 位数），
    // **但不超过可用宽度**——这是「不溢出」的唯一硬保证。
    // 口径权衡：窗口极窄且用户又把留白调到最大（实测最小窗口宽度 + 最大留白）时，
    // 空间不足同时保不住两者，此时**优先保住数值框的最小 96**、滑块退让；
    // 若连96 都放不下，数值框按可用宽度收缩（不隐藏，保证仍可输入/看值）。
    // 不用比例运算（Slint 里 length 除法会产出 float，需显式单位，徒增歧义）：
    // 直接「可用宽度减去滑块应得的空间」。滑块空间取「可用 - 数字框上限」与
    // 「可用 * 7/10 向上取整」的较大者，用**整数减法**表达，避免除法。
    private property <length> number-field-width: min(UiMetrics.search-field-width - UiMetrics.space-48 * 2,
        max(0px, max(UiMetrics.space-48 * 2, root.row-controls-avail - root.row-slider-reserve)));

    // 滑块「应得」空间：正常情况留给滑块 ≈ 7/10 可用宽度（用减法表达比例，避免除法）：
    // = avail - 数字框上限。数字框上限固定 144，故 avail 越大、滑块留白越多。
    // 当 avail <= 数字框上限 + 最小滑块（160）时，reserve 退为 avail - 160，保证滑块不被压没。
    private property <length> row-slider-reserve: max(0px,
        max(root.row-controls-avail - (UiMetrics.search-field-width - UiMetrics.space-48 * 2),
            root.row-controls-avail - (UiMetrics.space-48 * 3 + UiMetrics.space-16)));

    // 滑杆宽度：吃除间距外的剩余量（可被压到很小，但不为负）。
    private property <length> slider-bar-width: max(0px,
        root.row-controls-avail - UiMetrics.space-16 - root.number-field-width);

    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: UiMetrics.page-header-height;
        background: transparent;

        Text {
            x: UiMetrics.space-16;
            y: UiMetrics.space-16;
            text: "设置";
            font-size: UiMetrics.title-font-size;
            font-weight: 600;
            color: Skin.text-primary;
        }
        Text {
            x: UiMetrics.space-16;
            y: UiMetrics.space-16 + UiMetrics.space-32 + UiMetrics.space-4;
            text: root.note;
            font-size: UiMetrics.caption-font-size;
            color: Skin.text-placeholder;
            overflow: elide;
            width: parent.width - 2 * UiMetrics.space-16;
        }
    }

    // 键盘翻动（PageUp/PageDown/↑/↓/Home/End）；滚轮与拖动由 Flickable 负责。
    // 设置内容视口：Flickable 负责**滚轮与拖动**（原生行为），内容为**绝对定位行**
    // （每行 y/height 由 Rust 投影），不使用布局引擎 —— 滚动时控件不会错位。
    settings-view := Rectangle {
        x: 0;
        y: UiMetrics.page-header-height;
        width: parent.width;
        height: parent.height - UiMetrics.page-header-height;
        background: transparent;
        clip: true;

        // 滚轮（下层；不遮挡行内控件的点击）。
        settings-wheel := TouchArea {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            scroll-event(event) => {
                root.scroll-by(event.delta-y);
                accept
            }
        }

        settings-layout := Rectangle {
            x: UiMetrics.space-16;
            y: 0px - root.scroll-y;
            width: parent.width - 2 * UiMetrics.space-16;
            height: max(root.content-height, parent.height);
            background: transparent;

            for row in root.rows : Rectangle {
                x: 0;
                y: row.offset-y;
                width: parent.width;
                height: row.row-height;
                background: row.kind == 5 ? transparent : Skin.layer-02;
                border-width: row.kind == 5 ? 0px : UiMetrics.hairline;
                border-color: Skin.border-subtle;

                // 分组标题（含说明）。
                if row.kind == 5 : Text {
                    x: 0;
                    y: (parent.height - self.height) / 2;
                    // 分组标题**只显示标题本身**（2026-10-04）：原先 `label + "　" + note`
                    // 拼成一行，窄窗必然被裁；说明改为下方独立信息块（kind 7）。
                    text: row.label;
                    font-size: UiMetrics.ui-font-size;
                    font-weight: 600;
                    color: Skin.text-primary;
                    vertical-alignment: center;
                }

                // 分组说明（kind 7）：独立信息块，自动换行、不截断。
                //
                // ⚠️ **不复用** `InlineNotice`：它带「关闭」按钮与 `dismissed` 回调，
                // 而分组说明是**常驻说明**（无状态可存、无「关闭」语义），复用会导致
                // 用户点× 后整块消失且无处恢复。故用专用轻量块`SectionNote`。
                if row.kind == 7 : SectionNote {
                    x: UiMetrics.space-16;
                    y: 0;
                    width: parent.width - UiMetrics.space-16 * 2;
                    // 说明块高度由组件**按内容自算**；此处不再沿用 Rust 的固定行高。
                    height: self.measured-height;
                    text: row.note;
                    // 首次 + 后续高度变化都回报（组件内部用changed 只在真变化时触发）。
                    init => {
                        root.note-height-changed(0, self.measured-height);
                    }
                    height-measured(height) => {
                        root.note-height-changed(0, height);
                    }
                }

                // 标签 + 说明（200 像素 列）。
                if row.kind != 5 : Text {
                    x: UiMetrics.space-16;
                    y: UiMetrics.space-8;
                    width: root.label-width - UiMetrics.space-16;
                    text: row.label;
                    font-size: UiMetrics.ui-font-size;
                    color: row.effective ? Skin.text-primary : Skin.text-disabled;
                    overflow: elide;
                }
                // 字段级说明（2026-10-04 主人三次反馈后定稿）：
                //  ① 左边距从 space-16 → **space-32**（橙黄小字仍偏紧，主人要求再加）；
                //  ② 宽度不再只占 label 列 —— 原来按 `label-width` 收窄，长句被挤成 4 行、
                //     右侧留大片空白，末行还压出信息区下沿；
                //     现铺满「控件区」并**避开右侧「暂未生效」Tag**。
                //     ⚠️ 本注释刻意不写带单位的尺寸值（`layout_constants.rs` 扫描全文含注释）。
                if row.kind != 5 && row.note != "" : Text {
                    x: UiMetrics.space-32;
                    y: UiMetrics.space-8 + UiMetrics.space-16 + UiMetrics.space-4;
                    // 右界 = 行宽 − 右边距 − （未生效项才有的 Tag 区宽）
                    width: parent.width - self.x - UiMetrics.space-16
                        - (row.effective ? 0px : UiMetrics.space-48 + UiMetrics.space-16);
                    text: row.note;
                    font-size: UiMetrics.caption-font-size;
                    color: row.effective ? Skin.text-placeholder : Skin.support-warning;
                    wrap: word-wrap;
                    height: self.preferred-height;
                }
                // kind 0：字体族（点击循环切换）。
                if row.kind == 0 : Rectangle {
                    x: root.control-x;
                    y: UiMetrics.space-8;
                    width: UiMetrics.search-field-width;
                    height: UiMetrics.button-height-compact;
                    background: Skin.field-01;
                    border-width: UiMetrics.hairline;
                    border-color: Skin.border-strong;

                    Text {
                        x: UiMetrics.space-8;
                        y: (parent.height - self.height) / 2;
                        width: parent.width - 3 * UiMetrics.space-8 - UiMetrics.icon-size;
                        text: row.value;
                        font-size: UiMetrics.ui-font-size;
                        color: Skin.text-primary;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Icon {
                        x: parent.width - UiMetrics.space-8 - self.width;
                        y: (parent.height - self.height) / 2;
                        shape: Icons.chevron-down;
                        size: UiMetrics.icon-size;
                        color: Skin.text-secondary;
                    }
                    TouchArea {
                        clicked => {
                            root.select-toggle(row.key);
                        }
                    }
                }

                // kind 1：数值滑杆（滑杆 + 数值框 + 边界值）。
                if row.kind == 1 : SliderBar {
                    x: root.control-x;
                    y: UiMetrics.space-8 + UiMetrics.space-8;
                    width: root.slider-bar-width;
                    value: row.value-current;
                    minimum: row.value-min;
                    maximum: row.value-max;
                    changed(value) => {
                        root.set-int(row.key, value);
                    }
                }
                if row.kind == 1 : TextField {
                    x: root.control-x + root.slider-bar-width + UiMetrics.space-16;
                    y: UiMetrics.space-8;
                    width: root.number-field-width;
                    compact: true;
                    text: row.value;
                    label: row.label;
                    edited(text) => {
                        root.set-text(row.key, text);
                    }
                }
                if row.kind == 1 : Text {
                    x: root.control-x;
                    y: UiMetrics.space-8 + UiMetrics.space-48;
                    width: root.slider-bar-width;
                    text: row.range-label;
                    font-family: "monospace";
                    font-size: UiMetrics.mono-font-size;
                    color: Skin.text-placeholder;
                }

                // kind 2：枚举单选（≤4 项）。
                if row.kind == 2 : Rectangle {
                    x: root.control-x;
                    y: UiMetrics.space-8;
                    width: parent.width - self.x - UiMetrics.space-16;
                    height: UiMetrics.space-24;

                    for option[index] in row.options : RadioItem {
                        x: index * (UiMetrics.space-48 * 2 + UiMetrics.space-24);
                        y: 0;
                        width: UiMetrics.space-48 * 2 + UiMetrics.space-24 - UiMetrics.space-8;
                        caption: option;
                        checked: index == row.current-index;
                        selected => {
                            root.set-index(row.key, index);
                        }
                    }
                }

                // kind 3：布尔开关。
                if row.kind == 3 : SwitchToggle {
                    x: root.control-x;
                    y: UiMetrics.space-8 + UiMetrics.space-8;
                    checked: row.checked;
                    toggled(checked) => {
                        root.toggle(row.key, checked);
                    }
                }

                // kind 4：只读文本行（值可能是机器可核对信息）；未生效项带黄色 Tag。
                if row.kind == 4 && !row.effective : Tag {
                    x: parent.width - UiMetrics.space-16 - self.width;
                    y: (parent.height - self.height) / 2;
                    tone: 3;
                    text: "暂未生效";
                }
                if row.kind == 4 : Text {
                    x: root.control-x;
                    y: UiMetrics.space-8;
                    width: parent.width - self.x - UiMetrics.space-16 - (row.effective ? 0px : (UiMetrics.space-48 + UiMetrics.space-16));
                    text: row.value;
                    font-family: row.mono ? "monospace" : "";
                    font-size: row.mono ? UiMetrics.mono-font-size : UiMetrics.ui-font-size;
                    color: row.effective ? Skin.text-secondary : Skin.text-disabled;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-alignment: right;
                }

                // kind 8：基色输入（V1.1；设计稿 T1「四个取色器」）。
                //
                // 左色块**直接用该基色**填充（`swatch` 由 Rust 投影时算好），
                // 右侧是可编辑的 `#RRGGBB` 文本；**校验在 Rust**，
                // 界面不做颜色解析（也不判断对比度）。
                if row.kind == 8 : Rectangle {
                    x: root.control-x;
                    y: UiMetrics.space-8 + (UiMetrics.list-row-height - UiMetrics.swatch-size) / 2;
                    width: UiMetrics.swatch-size;
                    height: UiMetrics.swatch-size;
                    border-radius: UiMetrics.space-4;
                    // 无效色值时用 `skin.border-strong` 描边示意（`row.effective` 由 Rust 判定）。
                    background: row.effective ? row.swatch : Skin.field-01;
                    border-width: UiMetrics.hairline;
                    border-color: row.effective ? Skin.border-subtle : Skin.support-error;
                }
                if row.kind == 8 : TextField {
                    x: root.control-x + UiMetrics.swatch-size + UiMetrics.space-8;
                    y: UiMetrics.space-8;
                    width: parent.width - self.x - UiMetrics.space-16;
                    // 提示语含格式要求（`#RRGGBB`）；实际校验在 Rust。
                    label: row.value;
                    edited(text) => {
                        root.set-text(row.key, text);
                    }
                }

                // kind 9：通用动作行（V1.1；如「选择背景图…」/「清除背景图」）。
                //
                // 具体动作由 **Rust 按 key 分派**（`.slint` 不认识业务含义，
                // 也不判断文件是否存在）。
                if row.kind == 9 : TextButton {
                    x: root.control-x;
                    y: UiMetrics.space-8;
                    variant: 1;
                    compact: true;
                    caption: row.label;
                    activated => {
                        root.cycle(row.key);
                    }
                }
                if row.kind == 9 : Text {
                    x: root.control-x;
                    y: UiMetrics.space-8 + UiMetrics.space-16 + UiMetrics.space-4;
                    width: parent.width - self.x - UiMetrics.space-16;
                    text: row.value;
                    font-size: UiMetrics.caption-font-size;
                    color: Skin.text-placeholder;
                    overflow: elide;
                }

                // kind 6：动作行（如「清理章节索引与分页缓存…」）。
                if row.kind == 6 : TextButton {
                    x: root.control-x;
                    y: UiMetrics.space-8;
                    variant: 1;
                    compact: true;
                    caption: row.label;
                    activated => {
                        root.clear-index();
                    }
                }
                if row.kind == 6 : Text {
                    x: root.control-x;
                    y: UiMetrics.space-8 + UiMetrics.space-16 + UiMetrics.space-4;
                    width: parent.width - self.x - UiMetrics.space-16;
                    text: row.note;
                    font-size: UiMetrics.caption-font-size;
                    color: Skin.text-placeholder;
                    overflow: elide;
                }
            }

            Rectangle {
                x: 0;
                y: root.content-height - UiMetrics.space-24;
                width: parent.width;
                height: UiMetrics.space-24;
                background: transparent;
            }
        }
    }

    // 选择型字段的下拉列表（点击字段展开；点其他处或选中后收起）。
    if root.select-open : TouchArea {
        x: 0;
        y: UiMetrics.page-header-height;
        width: parent.width;
        height: parent.height - UiMetrics.page-header-height;
        clicked => {
            root.select-close();
        }
    }
    if root.select-open : Rectangle {
        // 字段位于内容容器内（容器整体左移 space-16），下拉层是页面直属子元素，
        // 因此必须补上这 16 像素，否则左右与字段错开（真实缺陷回归）。
        x: UiMetrics.space-16 + root.control-x;
        y: UiMetrics.page-header-height + root.select-y - root.scroll-y;
        width: UiMetrics.search-field-width;
        height: root.select-options.length * UiMetrics.list-row-height + 2 * UiMetrics.space-4;
        background: Skin.layer-02;
        border-width: UiMetrics.hairline;
        border-color: Skin.border-strong;
        drop-shadow-color: #00000026;
        drop-shadow-blur: UiMetrics.space-8;
        drop-shadow-offset-y: UiMetrics.space-4;

        for option[index] in root.select-options : Rectangle {
            x: 0;
            y: UiMetrics.space-4 + index * UiMetrics.list-row-height;
            width: parent.width;
            height: UiMetrics.list-row-height;
            background: index == root.select-index ? Skin.primary-soft : transparent;

            Text {
                x: UiMetrics.space-8;
                y: 0;
                width: parent.width - 2 * UiMetrics.space-8;
                height: parent.height;
                text: option;
                font-size: UiMetrics.ui-font-size;
                color: index == root.select-index ? Skin.primary : Skin.text-primary;
                vertical-alignment: center;
                overflow: elide;
            }
            TouchArea {
                clicked => {
                    root.set-index(root.select-key, index);
                    root.select-close();
                }
            }
        }
    }

    // 键盘翻动（PageUp/PageDown/↑/↓/Home/End）；焦点在页面空白处点击时夺回。
    settings-keys := FocusScope {
        x: 0;
        y: UiMetrics.page-header-height;
        width: parent.width;
        height: parent.height - UiMetrics.page-header-height;

        init => {
            self.focus();
        }

        key-pressed(event) => {
            if (event.text == Key.PageDown) {
                root.scroll-by(self.height - UiMetrics.list-row-height);
                accept
            } else if (event.text == Key.PageUp) {
                root.scroll-by(UiMetrics.list-row-height - self.height);
                accept
            } else if (event.text == Key.DownArrow) {
                root.scroll-by(UiMetrics.list-row-height);
                accept
            } else if (event.text == Key.UpArrow) {
                root.scroll-by(0px - UiMetrics.list-row-height);
                accept
            } else if (event.text == Key.Home) {
                root.scroll-by(0px - root.content-height);
                accept
            } else if (event.text == Key.End) {
                root.scroll-by(root.content-height);
                accept
            } else {
                reject
            }
        }
    }

    // 设置区滚动条（自绘：拖动/点击 → 回调 Rust 计算并夹紧滚动位置）。
    ScrollBar {
        x: parent.width - UiMetrics.scrollbar-gutter;
        y: UiMetrics.page-header-height;
        height: parent.height - UiMetrics.page-header-height;
        ratio: root.scroll-y / max(UiMetrics.hairline, root.content-height - root.viewport-height);
        handle-ratio: min(1, root.viewport-height / max(UiMetrics.hairline, root.content-height));
        seek(ratio) => {
            root.scroll-to(ratio);
        }
    }


    // 设置区滚动条（8）。
}

// ---------------------------------------------------------------------------
// S11：导入中 / S12：错误态
// ---------------------------------------------------------------------------

component ImportingPage inherits Rectangle {
    in property <string> file-name: "";
    in property <string> file-size: "";
    in property <int> percent: 0;
    in property <[StepRow]> steps: [];
    in property <string> note: "";
    in property <string> status: "";

    background: transparent;

    VerticalLayout {
        x: (parent.width - self.width) / 2;
        y: UiMetrics.space-48;
        width: min(parent.width - 2 * UiMetrics.space-16, UiMetrics.card-width * 2);
        spacing: UiMetrics.space-16;
        alignment: start;

        Rectangle {
            height: UiMetrics.space-32;
            background: transparent;

            Icon {
                x: (parent.width - self.width) / 2;
                shape: Icons.book;
                size: UiMetrics.space-32;
                color: Skin.primary;
            }
        }
        Text {
            text: "正在导入…";
            font-size: UiMetrics.heading-font-size;
            font-weight: 600;
            color: Skin.text-primary;
            horizontal-alignment: center;
            width: parent.width;
        }
        Text {
            text: root.file-name + "　" + root.file-size;
            font-family: "monospace";
            font-size: UiMetrics.mono-font-size;
            color: Skin.text-secondary;
            horizontal-alignment: center;
            width: parent.width;
            overflow: elide;
        }
        Rectangle {
            width: parent.width;
            height: UiMetrics.progress-bar-height + UiMetrics.space-4;
            background: Skin.border-subtle;

            Rectangle {
                x: 0;
                y: 0;
                width: parent.width * min(100, max(0, root.percent)) / 100;
                height: UiMetrics.progress-bar-height;
                background: Skin.primary;
            }
        }
        Text {
            text: root.percent + "%";
            font-family: "monospace";
            font-size: UiMetrics.mono-font-size;
            color: Skin.text-secondary;
            horizontal-alignment: center;
            width: parent.width;
        }
        for step in root.steps : HorizontalLayout {
            width: parent.width;
            height: UiMetrics.space-24;
            spacing: UiMetrics.space-8;

            Rectangle {
                width: UiMetrics.space-16;
                height: UiMetrics.space-16;
                border-radius: self.height / 2;
                background: step.state == 2 ? Skin.support-success : (step.state == 1 ? Skin.primary : Skin.border-subtle);
            }
            Text {
                text: step.label;
                font-size: UiMetrics.ui-font-size;
                color: step.state == 0 ? Skin.text-placeholder : Skin.text-primary;
                font-weight: step.state == 1 ? 600 : 400;
                vertical-alignment: center;
            }
        }
        Text {
            text: root.note;
            font-size: UiMetrics.caption-font-size;
            color: Skin.text-placeholder;
            wrap: word-wrap;
            height: self.preferred-height;
            width: parent.width;
        }
        Text {
            text: root.status;
            font-size: UiMetrics.caption-font-size;
            color: Skin.text-secondary;
            wrap: word-wrap;
            height: self.preferred-height;
            width: parent.width;
        }
    }
}

component ErrorPage inherits Rectangle {
    in property <string> title: "";
    in property <string> reason: "";
    in property <string> details: "";
    in-out property <bool> details-open: false;
    callback retry();
    callback back();

    background: transparent;

    VerticalLayout {
        x: (parent.width - self.width) / 2;
        y: UiMetrics.space-48;
        width: min(parent.width - 2 * UiMetrics.space-16, UiMetrics.card-width * 2);
        spacing: UiMetrics.space-16;
        alignment: start;

        Rectangle {
            height: UiMetrics.space-32;
            background: transparent;

            Icon {
                x: (parent.width - self.width) / 2;
                shape: Icons.error;
                size: UiMetrics.space-32;
                color: Skin.support-error;
            }
        }
        Text {
            text: root.title;
            font-size: UiMetrics.heading-font-size;
            font-weight: 600;
            color: Skin.text-primary;
            horizontal-alignment: center;
            width: parent.width;
        }
        Text {
            text: root.reason;
            font-size: UiMetrics.ui-font-size;
            color: Skin.text-secondary;
            horizontal-alignment: center;
            width: parent.width;
            wrap: word-wrap;
            height: self.preferred-height;
        }
        HorizontalLayout {
            alignment: center;
            spacing: UiMetrics.space-8;
            height: UiMetrics.button-height;

            TextButton {
                variant: 0;
                caption: "重新选择文件…";
                activated => {
                    root.retry();
                }
            }
            TextButton {
                variant: 2;
                caption: "返回书架";
                activated => {
                    root.back();
                }
            }
        }
        TextButton {
            x: 0;
            variant: 2;
            compact: true;
            caption: root.details-open ? "收起技术详情" : "技术详情";
            activated => {
                root.details-open = !root.details-open;
            }
        }
        if root.details-open : Text {
            text: root.details;
            font-family: "monospace";
            font-size: UiMetrics.mono-font-size;
            color: Skin.text-placeholder;
            wrap: word-wrap;
            height: self.preferred-height;
            width: parent.width;
        }
    }
}

// ---------------------------------------------------------------------------
// 主窗口：UI Shell 顶栏 + 页面切换 + 状态栏 + 弹窗 + Toast
// ---------------------------------------------------------------------------


export component AppWindow inherits Window {
    title: "novel-reader";
    // 窗口图标：编译期内嵌（Slint `@image-url`），资源来源与刷新口径见
    // `desktop/assets/icons/README.md`（设计事实来源在 `docs/design/icon/`）。
    // 支持它的窗口管理器会把它显示在标题栏/任务栏；不支持时静默忽略，不影响启动。
    icon: @image-url("../assets/icons/novel-reader-256.png");
    preferred-width: UiMetrics.default-window-width;
    preferred-height: UiMetrics.default-window-height;
    min-width: UiMetrics.min-window-width;
    min-height: UiMetrics.min-window-height;
    background: Skin.background;

    // ---- Rust → UI（只读投影；Rust 是唯一状态源）----
    in property <int> current-screen: 0;
    in property <string> app-version: "";
    in property <bool> theme-dark: false;
    // 状态栏
    in property <string> status-text: "";
    in property <string> status-chapter: "";
    in property <string> status-page: "";
    in property <string> status-percent: "";
    in property <string> status-meta: "";
    in property <string> status-reflow: "";
    // 阅读页
    in property <string> reader-heading: "";
    in property <bool> reader-toolbar-open: false;
    in property <bool> reader-immersive: false;
    in property <bool> reader-floating-toolbar: false;
    in property <bool> reader-gesture-mode: false;
    in property <[string]> reader-page-lines: [];
    in property <length> reader-line-pitch: 0px;
    in property <length> reader-body-font-size: 0px;
    in property <string> reader-body-font-family: "";
    in property <length> reader-column-x: 0px;
    in property <length> reader-column-y: 0px;
    in property <length> reader-column-width: 0px;
    in property <length> reader-column-height: 0px;
    in property <int> reader-progress-permille: 0;
    in property <string> reader-shortcut-prev: "";
    in property <string> reader-shortcut-next: "";
    in property <string> reader-shortcut-immersive: "";
    // 目录面板
    in property <bool> reader-toc-open: false;
    in property <[TocRow]> reader-toc-rows: [];
    in property <float> reader-toc-ratio: 0;
    in property <float> reader-toc-handle-ratio: 0.2;
    in property <string> reader-toc-count: "";
    in property <string> reader-toc-readout: "";
    in property <string> reader-toc-search: "";
    // 书签面板
    in property <bool> reader-marks-open: false;
    in property <[MarkRow]> reader-mark-rows: [];
    in property <string> reader-mark-count: "";
    in property <string> reader-mark-readout: "";
    in property <string> reader-rename-text: "";
    in property <string> reader-mark-search: "";
    // 选项（S8）与弹窗
    in property <int> dialog: 0;
    in property <string> confirm-title: "";
    in property <string> confirm-body: "";
    in property <string> confirm-note: "";
    in property <string> confirm-checkbox-label: "";
    in property <string> confirm-label: "";
    in property <bool> confirm-danger: false;
    in property <string> choice-title: "";
    in property <string> choice-meta: "";
    in property <[ChoiceRow]> choice-rows: [];
    in property <int> choice-current-index: 0;
    in property <[ShortcutEntry]> shortcut-rows: [];
    in property <string> rename-title: "";
    in property <string> rename-value: "";
    // 书架
    in property <[BookRow]> book-rows: [];
    in property <bool> shelf-empty: false;
    in property <string> shelf-empty-title: "";
    in property <string> shelf-empty-desc: "";
    in property <[string]> shelf-empty-notes: [];
    in property <int> shelf-view: 0;
    in property <string> shelf-search: "";
    in property <string> shelf-sort-value: "";
    // 书架排序序号（0=最近阅读 1=书名 2=导入时间）。
    in property <int> shelf-sort-current: 0;
    in property <string> shelf-count: "";
    in property <bool> shelf-notice: false;
    in property <string> shelf-notice-title: "";
    in property <string> shelf-notice-body: "";
    in property <int> shelf-menu-index: -1;
    // 分类侧栏（V1.1）：行投影由 Rust 给出；可见性与选中态也是 Rust 判定。
    in property <[CategoryRow]> category-rows: [];
    in property <bool> shelf-sidebar-visible: false;
    in property <string> shelf-selected-category: "";
    // 分类行内菜单（V1.1）。
    in property <string> category-menu-id: "";
    in property <int> category-menu-offset: -1;
    // 分类操作浮层（V1.1）。can-confirm 由 Rust 判定（未选去向 / 名称为空 → 禁用）。
    in property <bool> category-dialog-open: false;
    in property <int> category-dialog-mode: 0;
    in property <string> category-dialog-title: "";
    in property <string> category-dialog-parent: "";
    in property <string> category-dialog-value: "";
    in property <string> category-dialog-error: "";
    in property <string> category-dialog-note: "";
    in property <string> category-dialog-label: "保存";
    in property <bool> category-dialog-can-confirm: false;
    in property <[ChoiceRow]> category-target-rows: [];
    in property <int> category-target-index: -1;
    // 导入归类浮层（V1.1；设计稿 C7）。
    in property <bool> organize-dialog-open: false;
    in property <string> organize-title: "";
    in property <string> organize-scope: "";
    in property <string> organize-summary: "";
    in property <[OrganizeRow]> organize-preview: [];
    in property <bool> organize-remember: false;
    // 全局阅读背景图（V1.1；设计稿 B1–B3）。
    // 图片本身由 Rust 加载后注入（`slint::Image`）；路径不进界面。
    in property <image> reader-background-image;
    // 三项都由 Rust 投影：`fit` 是 FitMode 序号、`scrim` 是 0–255 的 alpha
    // （界面不换算千分比，也**不参与分页** —— 分页只看文字流）。
    in property <bool> reader-background-set: false;
    in property <int> reader-background-fit: 0;
    in property <int> reader-background-scrim: 0;
    // 阅读历史（V1.1；设计稿 H1–H3）。
    in property <bool> history-mode: false;
    in property <[HistoryRow]> history-rows: [];
    in property <[HistoryGroupHead]> history-groups: [];
    in property <bool> history-grouped: false;
    in property <bool> history-empty: false;
    in property <string> history-empty-title: "";
    in property <string> history-empty-desc: "";
    in property <string> history-count: "";
    // 设置
    in property <[SettingsRow]> settings-rows: [];
    in property <string> settings-note: "";
    in property <string> settings-data-path: "";
    // 设置页表单内容高度（像素；由 Rust 按行高口径求和投影）。
    in property <length> settings-content-height: 0px;
    // 设置页滚动偏移与视口高度（Rust 持有；拖动/键盘/滚轮都经 Rust 计算并夹紧）。
    in property <length> settings-scroll-y: 0px;
    in property <length> settings-viewport-height: 0px;
    // 设置页下拉框（选择型字段）。
    in property <bool> settings-select-open: false;
    in property <length> settings-select-y: 0px;
    in property <string> settings-select-key: "";
    in property <int> settings-select-index: 0;
    in property <[string]> settings-select-options: [];
    // 导入 / 错误
    in property <string> import-file: "";
    in property <string> import-size: "";
    in property <int> import-percent: 0;
    in property <[StepRow]> import-steps: [];
    in property <string> import-note: "";
    in property <string> error-title: "";
    in property <string> error-reason: "";
    in property <string> error-details: "";
    in property <string> placeholder-status: "";
    // 顶栏按钮提示（窗口顶层浮层；避免被阅读工具条遮挡）
    in property <string> header-tip-text: "";
    in property <length> header-tip-anchor-x: 0px;
    in property <int> header-tip-prefer: 1;
    callback header-tip-request(string, length, int);

    // Toast
    in property <bool> toast-visible: false;
    in property <string> toast-text: "";
    in property <string> toast-action: "";

    // ---- UI → Rust（只上报意图，页面语义由 Rust 决定）----
    callback navigate(int);
    callback theme-toggle();
    callback shortcuts-toggle();
    callback quit-requested();
    callback reader-prev-page();
    callback reader-next-page();
    callback toggle-reader-toolbar();
    callback reader-immersive-toggle();
    callback reader-save-progress();
    callback reader-progress-seek(float);
    callback reader-zone-hover(bool);
    callback reader-options-toggle();
    callback toc-toggle();
    callback toc-scroll(int);
    callback toc-wheel(length);
    callback toc-seek(length, length);
    callback toc-search-edited(string);
    callback chapter-jump(string);
    callback marks-toggle();
    callback marks-scroll(int);
    callback mark-search-edited(string);
    callback mark-add();
    callback mark-select(string);
    callback mark-jump(string);
    callback mark-rename(string);
    callback mark-delete(string);
    callback mark-delete-confirm(string);
    callback mark-delete-cancel();
    callback rename-text-edited(string);
    callback choice-toggle();
    callback choice-select(string);
    callback overlay-click();
    callback key-input(string, bool);
    callback wheel-input(length, length);
    // 书架
    callback shelf-import();
    callback shelf-search-edited(string);
    callback shelf-view-set(int);
    callback shelf-sort-cycle();
    callback shelf-sort-set(int);
    callback settings-scroll-by(length);
    callback settings-scroll-to(float);
    // 设置页说明块实测高度回报（转发给 Rust；Rust 据此重算整页高度）。
    callback settings-note-height(int, length);
    callback settings-select-toggle(string);
    callback settings-select-close();
    callback shelf-open-book(string);
    callback shelf-row-menu(int);
    callback shelf-row-action(string, string);
    callback shelf-relink-all();
    callback shelf-notice-dismiss();
    // 分类侧栏（V1.1）：选中 / 折叠 / 行菜单 / 新建 / 批量导入。
    callback shelf-category-select(string);
    callback shelf-category-toggle(string);
    callback shelf-category-menu(string);
    callback shelf-category-add();
    callback shelf-import-batch();
    // 分类行内菜单（V1.1）。
    callback category-menu-picked(string, string);
    callback category-menu-close();
    // 分类操作浮层（V1.1）。
    callback category-dialog-name-edited(string);
    callback category-dialog-target-picked(int);
    callback category-dialog-confirm();
    // 导入归类浮层（V1.1）。
    callback organize-remembered(bool);
    callback organize-import-plain();
    callback organize-import-organized();
    // 阅读历史（V1.1）。
    callback shelf-history-toggle();
    callback shelf-history-clear();
    callback shelf-history-open(string);
    callback shelf-history-row-menu(string);
    callback shelf-history-group-toggle(string);
    callback shelf-history-group-menu(string);
    callback shelf-history-view-set(bool);
    // 设置
    callback settings-cycle(string);
    callback settings-set-int(string, int);
    callback settings-set-text(string, string);
    callback settings-set-index(string, int);
    callback settings-toggle(string, bool);
    callback settings-clear-index();
    // 弹窗与 Toast
    callback dialog-cancel();
    callback dialog-confirm(bool);
    callback dialog-choice-apply(int);
    callback dialog-rename-save(string);
    callback toast-action-clicked();
    // 导入 / 错误
    callback import-retry();
    callback import-back();
    // 窗口映射完成或尺寸变化。
    callback viewport-changed(length, length);

    // 只在尺寸真的变化时上报（事件循环启动前的 0×0 不会触发）。
    changed width => {
        root.viewport-changed(root.width, root.height);
    }
    changed height => {
        root.viewport-changed(root.width, root.height);
    }

    // 字体度量探针：与正文逐行 Text 使用完全相同的字体属性，位置在窗口之外（不可见）。
    metrics-probe := Text {
        x: 0px - root.width;
        y: 0px - root.height;
        width: root.width;
        height: root.reader-body-font-size;
        text: "M";
        font-family: root.reader-body-font-family;
        font-size: root.reader-body-font-size;
    }
    out property <length> body-ascent: metrics-probe.font-metrics.ascent;
    out property <length> body-descent: metrics-probe.font-metrics.descent;

    // ---- 顶栏 UI Shell（48；深色 #161616，白字；沉浸态隐藏）----
    Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: UiMetrics.top-bar-height;
        visible: !root.reader-immersive;
        background: Skin.header;

        // 左：品牌 + 全局导航（横向布局）。
        HorizontalLayout {
            x: UiMetrics.space-16;
            y: 0;
            width: parent.width - 2 * UiMetrics.space-16;
            height: parent.height;
            spacing: UiMetrics.space-4;
            alignment: start;

            // 品牌（16 应用图标 + 15/600 文字）。图标取自设计事实来源
            // `docs/design/icon/`（单色白版，用于深色顶栏；设计稿即应用图标）。
            VerticalLayout {
                alignment: center;
                Image {
                    source: @image-url("../assets/icons/novel-reader-mono-white-32.png");
                    width: UiMetrics.icon-size;
                    height: UiMetrics.icon-size;
                }
            }
            Text {
                text: "novel-reader";
                font-size: UiMetrics.brand-font-size;
                font-weight: 600;
                color: Skin.header-text;
                vertical-alignment: center;
            }
            Rectangle {
                width: UiMetrics.space-16;
                background: transparent;
            }
            // 全局导航（项高 48；选中 600 + 底部 2 像素 主色）。
            NavItem {
                caption: "书架";
                active: root.current-screen == Screens.shelf;
                activated => {
                    root.navigate(Screens.shelf);
                }
            }
            NavItem {
                caption: "阅读";
                active: root.current-screen == Screens.reader;
                activated => {
                    root.navigate(Screens.reader);
                }
            }
            NavItem {
                caption: "设置";
                active: root.current-screen == Screens.settings;
                activated => {
                    root.navigate(Screens.settings);
                }
            }

            Rectangle { horizontal-stretch: 1; background: transparent; }

            // 全局动作：主题 / 快捷键 / 退出。
        }

        // 右：全局动作（主题 / 快捷键 / 退出）——**绝对贴右**。
        // 依赖布局拉伸时会被压到中间（真实缺陷回归），故显式定位：
        // x = 顶栏宽 - 页边距 16 - 自身宽；间距按设计口径 2。
        HorizontalLayout {
            // 必须显式声明宽度：布局元素不给宽度会撑满父级（Slint 规则），
            // 那样 x 会被算成负值、按钮被内部居中 —— 这正是「没贴右」的根因。
            width: self.preferred-width;
            x: parent.width - UiMetrics.space-16 - self.width;
            y: 0;
            height: parent.height;
            spacing: UiMetrics.hairline * 2;
            alignment: center;
                    // 锚点 = 按钮**中心**的窗口 x（组右缘 = 顶栏宽 - 16，向左逐钮累加间距）。
                    // 提示交窗口顶层渲染：顶栏仅 48 高，自绘提示会被下方阅读工具条遮住。
                    VerticalLayout {
                        alignment: center;
                        IconButton {
                            caption: "切换主题";
                            on-header: true;
                            // 模式切换按钮：亮色显示「月亮」（切到暗色），暗色显示「太阳」。
                            shape: root.theme-dark ? Icons.sun : Icons.moon;
                            tip-below: true;
                            tip-host: true;
                            tip-anchor-x: root.width - UiMetrics.space-16 - 2 * UiMetrics.icon-button-size - 4 * UiMetrics.hairline * 2 + UiMetrics.icon-button-size / 2;
                            tip-request(text, anchor, prefer) => {
                                root.header-tip-request(text, anchor, prefer);
                            }
                            activated => {
                                root.theme-toggle();
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        IconButton {
                            caption: "快捷键说明";
                            on-header: true;
                            shape: Icons.help;
                            tip-below: true;
                            tip-host: true;
                            tip-anchor-x: root.width - UiMetrics.space-16 - UiMetrics.icon-button-size - 2 * UiMetrics.hairline * 2 + UiMetrics.icon-button-size / 2;
                            tip-request(text, anchor, prefer) => {
                                root.header-tip-request(text, anchor, prefer);
                            }
                            activated => {
                                root.shortcuts-toggle();
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        IconButton {
                            caption: "退出";
                            on-header: true;
                            shape: Icons.power;
                            tip-below: true;
                            tip-host: true;
                            tip-anchor-x: root.width - UiMetrics.space-16 - UiMetrics.icon-button-size / 2;
                            tip-request(text, anchor, prefer) => {
                                root.header-tip-request(text, anchor, prefer);
                            }
                            activated => {
                                root.quit-requested();
                            }
                        }
                    }
        }
    }

    // ---- 页面 ----
    if root.current-screen == Screens.shelf : ShelfPage {
        x: 0;
        y: UiMetrics.top-bar-height;
        width: parent.width;
        height: parent.height - UiMetrics.top-bar-height - UiMetrics.status-bar-height;
        rows: root.book-rows;
        is-empty: root.shelf-empty;
        empty-title: root.shelf-empty-title;
        empty-desc: root.shelf-empty-desc;
        empty-notes: root.shelf-empty-notes;
        view: root.shelf-view;
        search: root.shelf-search;
        sort-value: root.shelf-sort-value;
        sort-current: root.shelf-sort-current;
        count-label: root.shelf-count;
        notice: root.shelf-notice;
        notice-title: root.shelf-notice-title;
        notice-body: root.shelf-notice-body;
        menu-index: root.shelf-menu-index;
        categories: root.category-rows;
        sidebar-visible: root.shelf-sidebar-visible;
        selected-category-id: root.shelf-selected-category;
        category-menu-id: root.category-menu-id;
        category-menu-offset: root.category-menu-offset;
        history-mode: root.history-mode;
        history-rows: root.history-rows;
        history-groups: root.history-groups;
        history-grouped: root.history-grouped;
        history-empty: root.history-empty;
        history-empty-title: root.history-empty-title;
        history-empty-desc: root.history-empty-desc;
        history-count: root.history-count;
        category-select(id) => {
            root.shelf-category-select(id);
        }
        category-toggle(id) => {
            root.shelf-category-toggle(id);
        }
        category-menu(id) => {
            root.shelf-category-menu(id);
        }
        category-add => {
            root.shelf-category-add();
        }
        import-batch => {
            root.shelf-import-batch();
        }
        category-menu-picked(action, id) => {
            root.category-menu-picked(action, id);
        }
        category-menu-close => {
            root.category-menu-close();
        }
        history-open(id) => {
            root.shelf-history-open(id);
        }
        history-row-menu(id) => {
            root.shelf-history-row-menu(id);
        }
        history-group-toggle(id) => {
            root.shelf-history-group-toggle(id);
        }
        history-group-menu(id) => {
            root.shelf-history-group-menu(id);
        }
        history-view-set(grouped) => {
            root.shelf-history-view-set(grouped);
        }
        history-toggle => {
            root.shelf-history-toggle();
        }
        history-clear => {
            root.shelf-history-clear();
        }
        import-txt => {
            root.shelf-import();
        }
        search-edited(text) => {
            root.shelf-search-edited(text);
        }
        view-set(view) => {
            root.shelf-view-set(view);
        }
        sort-cycle => {
            root.shelf-sort-cycle();
        }
        sort-set(index) => {
            root.shelf-sort-set(index);
        }
        open-book(id) => {
            root.shelf-open-book(id);
        }
        row-menu(index) => {
            root.shelf-row-menu(index);
        }
        row-action(action, id) => {
            root.shelf-row-action(action, id);
        }
        relink-all => {
            root.shelf-relink-all();
        }
        notice-dismiss => {
            root.shelf-notice-dismiss();
        }
    }

    if root.current-screen == Screens.reader : ReaderPage {
        x: 0;
        y: root.reader-immersive ? 0px : UiMetrics.top-bar-height;
        width: parent.width;
        height: root.reader-immersive ? parent.height : parent.height - UiMetrics.top-bar-height - UiMetrics.status-bar-height;
        heading: root.reader-heading;
        toolbar-open: root.reader-toolbar-open;
        immersive: root.reader-immersive;
        show-floating: root.reader-floating-toolbar;
        gesture-mode: root.reader-gesture-mode;
        page-lines: root.reader-page-lines;
        background-image: root.reader-background-image;
        background-set: root.reader-background-set;
        background-fit: root.reader-background-fit;
        background-scrim: root.reader-background-scrim;
        line-pitch: root.reader-line-pitch;
        body-font-size: root.reader-body-font-size;
        body-font-family: root.reader-body-font-family;
        column-x: root.reader-column-x;
        column-y: root.reader-column-y;
        column-width: root.reader-column-width;
        column-height: root.reader-column-height;
        progress-permille: root.reader-progress-permille;
        shortcut-prev: root.reader-shortcut-prev;
        shortcut-next: root.reader-shortcut-next;
        shortcut-immersive: root.reader-shortcut-immersive;
        toc-open: root.reader-toc-open;
        toc-rows: root.reader-toc-rows;
        toc-ratio: root.reader-toc-ratio;
        toc-handle-ratio: root.reader-toc-handle-ratio;
        toc-count: root.reader-toc-count;
        toc-readout: root.reader-toc-readout;
        toc-search: root.reader-toc-search;
        marks-open: root.reader-marks-open;
        mark-rows: root.reader-mark-rows;
        mark-count: root.reader-mark-count;
        mark-readout: root.reader-mark-readout;
        rename-text: root.reader-rename-text;
        mark-search: root.reader-mark-search;
        toolbar-toggle => {
            root.toggle-reader-toolbar();
        }
        immersive-toggle => {
            root.reader-immersive-toggle();
        }
        prev-page => {
            root.reader-prev-page();
        }
        next-page => {
            root.reader-next-page();
        }
        save-progress => {
            root.reader-save-progress();
        }
        progress-seek(ratio) => {
            root.reader-progress-seek(ratio);
        }
        zone-hover(hovered) => {
            root.reader-zone-hover(hovered);
        }
        options-clicked => {
            root.reader-options-toggle();
        }
        toc-toggle => {
            root.toc-toggle();
        }
        toc-wheel(delta) => {
            root.toc-wheel(delta);
        }
        toc-seek(pointer-y, track-height) => {
            root.toc-seek(pointer-y, track-height);
        }
        toc-search-edited(text) => {
            root.toc-search-edited(text);
        }
        chapter-jump(sequence) => {
            root.chapter-jump(sequence);
        }
        marks-toggle => {
            root.marks-toggle();
        }
        marks-scroll(delta) => {
            root.marks-scroll(delta);
        }
        mark-search-edited(text) => {
            root.mark-search-edited(text);
        }
        mark-add => {
            root.mark-add();
        }
        mark-select(id) => {
            root.mark-select(id);
        }
        mark-jump(id) => {
            root.mark-jump(id);
        }
        mark-rename(name) => {
            root.mark-rename(name);
        }
        mark-delete(id) => {
            root.mark-delete(id);
        }
        mark-delete-confirm(id) => {
            root.mark-delete-confirm(id);
        }
        mark-delete-cancel => {
            root.mark-delete-cancel();
        }
        rename-text-edited(text) => {
            root.rename-text-edited(text);
        }
        overlay-click => {
            root.overlay-click();
        }
        key-input(text, text-input-focused) => {
            root.key-input(text, text-input-focused);
        }
        wheel-input(delta-x, delta-y) => {
            root.wheel-input(delta-x, delta-y);
        }
    }

    if root.current-screen == Screens.settings : SettingsPage {
        x: 0;
        y: UiMetrics.top-bar-height;
        width: parent.width;
        height: parent.height - UiMetrics.top-bar-height - UiMetrics.status-bar-height;
        rows: root.settings-rows;
        note: root.settings-note;
        note-height-changed(row-index, height) => {
            root.settings-note-height(row-index, height);
        }
        data-path: root.settings-data-path;
        content-height: root.settings-content-height;
        scroll-y: root.settings-scroll-y;
        viewport-height: root.settings-viewport-height;
        scroll-by(delta) => {
            root.settings-scroll-by(delta);
        }
        scroll-to(ratio) => {
            root.settings-scroll-to(ratio);
        }
        select-open: root.settings-select-open;
        select-y: root.settings-select-y;
        select-key: root.settings-select-key;
        select-index: root.settings-select-index;
        select-options: root.settings-select-options;
        select-toggle(key) => {
            root.settings-select-toggle(key);
        }
        select-close() => {
            root.settings-select-close();
        }
        cycle(key) => {
            root.settings-cycle(key);
        }
        set-int(key, value) => {
            root.settings-set-int(key, value);
        }
        set-text(key, value) => {
            root.settings-set-text(key, value);
        }
        set-index(key, index) => {
            root.settings-set-index(key, index);
        }
        toggle(key, checked) => {
            root.settings-toggle(key, checked);
        }
        clear-index => {
            root.settings-clear-index();
        }
        clear-index-clicked => {
            root.settings-clear-index();
        }
    }

    if root.current-screen == Screens.importing : ImportingPage {
        x: 0;
        y: UiMetrics.top-bar-height;
        width: parent.width;
        height: parent.height - UiMetrics.top-bar-height - UiMetrics.status-bar-height;
        file-name: root.import-file;
        file-size: root.import-size;
        percent: root.import-percent;
        steps: root.import-steps;
        note: root.import-note;
        status: root.placeholder-status;
    }

    if root.current-screen == Screens.error : ErrorPage {
        x: 0;
        y: UiMetrics.top-bar-height;
        width: parent.width;
        height: parent.height - UiMetrics.top-bar-height - UiMetrics.status-bar-height;
        title: root.error-title;
        reason: root.error-reason;
        details: root.error-details;
        retry => {
            root.import-retry();
        }
        back => {
            root.import-back();
        }
    }

    // ---- 状态栏（32；信息 + 读数 + 翻页图标；沉浸态隐藏）----
    Rectangle {
        x: 0;
        y: parent.height - UiMetrics.status-bar-height;
        width: parent.width;
        height: UiMetrics.status-bar-height;
        visible: !root.reader-immersive;
        background: Skin.layer-01;

        Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: UiMetrics.hairline;
            background: Skin.border-subtle;
        }
        // 左：状态文本（绝对定位；右组绝对贴右 —— 与工具条同一模式）。
        HorizontalLayout {
            width: self.preferred-width;
            x: UiMetrics.space-16;
            y: 0;
            height: parent.height;
            spacing: UiMetrics.space-8;
            alignment: center;

            Text {
                width: min(self.preferred-width, UiMetrics.search-field-width * 2);
                text: root.status-text;
                font-size: UiMetrics.caption-font-size;
                color: Skin.text-secondary;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        // 右：章节 / 页码 / 百分比 / 编码 Tag / 版本 / 翻页按钮（绝对贴右）。
        HorizontalLayout {
            width: self.preferred-width;
            x: parent.width - UiMetrics.space-16 - self.width;
            y: 0;
            height: parent.height;
            spacing: UiMetrics.space-8;
            alignment: center;
            Text {
                text: root.status-reflow;
                font-size: UiMetrics.caption-font-size;
                color: Skin.support-warning;
                vertical-alignment: center;
                visible: root.status-reflow != "";
            }
            Text {
                text: root.status-chapter;
                font-family: "monospace";
                font-size: UiMetrics.mono-font-size;
                color: Skin.text-secondary;
                vertical-alignment: center;
                visible: root.current-screen == Screens.reader && !root.reader-immersive;
            }
            Text {
                text: root.status-page;
                font-family: "monospace";
                font-size: UiMetrics.mono-font-size;
                color: Skin.text-secondary;
                vertical-alignment: center;
                visible: root.current-screen == Screens.reader && !root.reader-immersive;
            }
            Text {
                text: root.status-percent;
                font-family: "monospace";
                font-size: UiMetrics.mono-font-size;
                color: Skin.text-secondary;
                vertical-alignment: center;
                visible: root.current-screen == Screens.reader && !root.reader-immersive && root.status-percent != "";
            }
            if root.status-meta != "" : VerticalLayout {
                alignment: center;

                Tag {
                    tone: 1;
                    text: root.status-meta;
                }
            }
            Text {
                text: root.app-version;
                font-family: "monospace";
                font-size: UiMetrics.mono-font-size;
                color: Skin.text-placeholder;
                vertical-alignment: center;
                visible: root.width >= UiMetrics.breakpoint-narrow;
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    compact: true;
                    caption: "上一页";
                    shortcut: root.reader-shortcut-prev;
                    shape: Icons.rewind;
                    visible: root.current-screen == Screens.reader && !root.reader-gesture-mode;
                    activated => {
                        root.reader-prev-page();
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    compact: true;
                    caption: "下一页";
                    shortcut: root.reader-shortcut-next;
                    shape: Icons.forward;
                    visible: root.current-screen == Screens.reader && !root.reader-gesture-mode;
                    activated => {
                        root.reader-next-page();
                    }
                }
            }
        }
    }

    // ---- 弹窗（S8 / S13 / S14 / S15）----
    if root.dialog == 1 : ConfirmDialog {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        title: root.confirm-title;
        body: root.confirm-body;
        note: root.confirm-note;
        checkbox-label: root.confirm-checkbox-label;
        confirm-label: root.confirm-label;
        danger: root.confirm-danger;
        cancelled => {
            root.dialog-cancel();
        }
        confirmed(checked) => {
            root.dialog-confirm(checked);
        }
    }
    if root.dialog == 2 : ShortcutsDialog {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        rows: root.shortcut-rows;
        dismissed => {
            root.dialog-cancel();
        }
    }
    if root.dialog == 3 : ChoiceDialog {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        title: root.choice-title;
        meta: root.choice-meta;
        rows: root.choice-rows;
        initial-index: root.choice-current-index;
        cancelled => {
            root.dialog-cancel();
        }
        applied(index) => {
            root.dialog-choice-apply(index);
        }
    }
    if root.dialog == 4 : RenameDialog {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        title: root.rename-title;
        label: "书架显示名";
        initial-value: root.rename-value;
        cancelled => {
            root.dialog-cancel();
        }
        saved(text) => {
            root.dialog-rename-save(text);
        }
    }

    // ---- 分类操作浮层（V1.1；新建/重命名、删除去向、移动到分类）----
    if root.category-dialog-open : CategoryActionDialog {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        mode: root.category-dialog-mode;
        title: root.category-dialog-title;
        parent-line: root.category-dialog-parent;
        name-value: root.category-dialog-value;
        error-line: root.category-dialog-error;
        note-line: root.category-dialog-note;
        confirm-label: root.category-dialog-label;
        can-confirm: root.category-dialog-can-confirm;
        targets: root.category-target-rows;
        target-index: root.category-target-index;
        name-edited(text) => {
            root.category-dialog-name-edited(text);
        }
        target-picked(index) => {
            root.category-dialog-target-picked(index);
        }
        confirmed => {
            root.category-dialog-confirm();
        }
        cancelled => {
            root.dialog-cancel();
        }
    }

    // ---- 导入归类浮层（V1.1）----
    if root.organize-dialog-open : ImportOrganizeDialog {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        title: root.organize-title;
        scope-line: root.organize-scope;
        summary-line: root.organize-summary;
        preview: root.organize-preview;
        remember: root.organize-remember;
        remembered(value) => {
            root.organize-remembered(value);
        }
        import-plain => {
            root.organize-import-plain();
        }
        import-organized => {
            root.organize-import-organized();
        }
        cancelled => {
            root.dialog-cancel();
        }
    }

    // ---- 顶栏按钮提示（**顶层**：声明在页面与弹窗之后，任何条带都盖不住）----
    // 按窗口坐标定位并夹紧：靠右按钮右对齐不越窗；向下落在顶栏之下（工具条在其后，故被它盖住？
    // 否——本浮层声明更晚，层级更高）。
    if root.header-tip-text != "" : Rectangle {
        // 贴顶栏下沿、位于工具条**之上**（顶层声明 → 层级最高）。
        // 夹紧：不越过窗口左右缘，各留 8 像素。
        x: max(UiMetrics.space-8, min(parent.width - self.width - UiMetrics.space-8, root.header-tip-anchor-x - self.width / 2));
        y: UiMetrics.top-bar-height + UiMetrics.space-4;
        width: header-tip-label.preferred-width + UiMetrics.space-12;
        height: UiMetrics.space-24;
        // 不透明 + 描边：确保叠在浅色工具条上仍清晰可读。
        background: Skin.toast-bg;
        border-width: UiMetrics.hairline;
        border-color: Skin.border-strong;
        border-radius: UiMetrics.toast-radius;

        header-tip-label := Text {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            text: root.header-tip-text;
            font-size: UiMetrics.caption-font-size;
            color: Skin.toast-text;
        }
    }

    // ---- Toast（右下；Rust 一次性定时器 3s 清除）----
    if root.toast-visible : Toast {
        x: parent.width - self.width - UiMetrics.space-24;
        y: parent.height - self.height - UiMetrics.status-bar-height - UiMetrics.space-24;
        text: root.toast-text;
        action-label: root.toast-action;
        activated => {
            root.toast-action-clicked();
        }
    }
}

