    out property <string> table: "M 2 3 H 14 M 2 6.5 H 14 M 2 10 H 14 M 2 13 H 14";
    out property <string> cards: "M 2 3 H 7 V 8 H 2 Z M 9 3 H 14 V 8 H 9 Z M 2 9 H 7 V 14 H 2 Z M 9 9 H 14 V 14 H 9 Z";
    out property <string> link: "M 6.2 9.8 L 9.8 6.2 M 4 7.5 A 3 3 0 0 1 7 4.5 L 8.2 4.5 M 12 8.5 A 3 3 0 0 1 9 11.5 L 7.8 11.5";
    out property <string> check: "M 3 8.5 L 6.5 12 L 13 4.5";
