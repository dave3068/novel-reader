    out property <string> toc: "M 2 4 H 14 M 2 8 H 14 M 2 12 H 14";
    out property <string> mark: "M 4 2 H 12 V 14 L 8 11 L 4 14 Z";
    out property <string> options: "M 2 5 H 14 M 2 11 H 14 M 6 3 V 7 M 10 9 V 13";
