//! novel-reader 桌面（Slint）UI —— 唯一的 UI 定义来源（v0.3.0）。
//!
//! 设计依据：`docs/design/novel-reader-desktop-redesign.md`（S1–S16 逐屏规格、令牌、组件库）。
//!
//! 边界（`desktop/spec.md` DR2、`design.md` §2）：
//!
//! - 本文件只做「状态投影 + 交互事件转发」。编码识别、章节识别、分页边界、位置校验、
//!   书签规则全部属于冻结核心 `reading-core`，UI 不得复制、也不得自行推断；
//! - 版式常量（尺寸 / 字号 / 间距）与配色令牌的**唯一来源**是
//!   `crates/desktop-app/src/layout.rs`。下面的 `UiMetrics` / `Skin` 只有属性声明
//!   （默认 `0 像素` / 透明），启动时由 Rust 的 `ui.rs::apply_layout_metrics` /
//!   `apply_palette` 注入真实数值；
//! - 本文件任何位置都不得写死尺寸（一律走 `UiMetrics.*`），由
//!   `scripts/verify-desktop-scope.py` 与 `tests/layout_constants.rs` 双重强制；
//! - 一切面向用户的**结果/状态文案**（含 tooltip 里的快捷键）由 Rust 投影；
//!   界面只保留固定的结构性格文案（栏位名、按钮动作名、分组标题）；
//! - `Screens` 的序号与 Rust `app_state::Screen::index()` 一致，由 Rust 投影驱动。

// ---------------------------------------------------------------------------
// 视图结构（只含可显示字段；全部由 Rust 投影）
// ---------------------------------------------------------------------------

// 书架一行：书名/文件 + 状态 Tag + 进度 + 最近阅读 + 行级入口。
export struct BookRow {
    id: string,
    title: string,
    initial: string,
    meta: string,
    status: string,
    // 语义槽位（Rust 判定）：0=中性 1=信息（蓝）2=成功（绿）3=警告（黄）4=错误（红）
    status-tone: int,
    progress: string,
    // 进度千分比（0..1000；2 像素 进度条用）
    percent: int,
    recent: string,
    needs-relink: bool,
    can-open: bool,
}

// 分类侧栏一行（V1.1）。
//
// 全部字段由 Rust 的 `category_tree::project` 投影给出：层级（depth）、
// 计数、选中、折叠、循环不可选（move-blocked）**全部是 Rust 的判定**，
// 界面只按 depth 缩进、按 selected/expanded 上色、按 move-blocked 置灰。
export struct CategoryRow {
    id: string,
    name: string,
    // 0 基深度（根下分类为 1，因为「全部书籍」占第 0 行）。
    depth: int,
    direct-count: int,
    total-count: int,
    has-children: bool,
    expanded: bool,
    selected: bool,
    // 移动分类时不可选（自身与全部子孙；判定来自 Rust）。
    move-blocked: bool,
    // 虚拟行（全部书籍 / 未分类）不显示行内菜单。
    virtual-row: bool,
    // 0=全部书籍 1=未分类 2=真实分类。
    kind: int,
}

// 导入归类对话框一行（V1.1；批量导入的预览与两个确认态）。
//
// `count` 是**已格式化**的文本（Rust 侧拼好，如 "3 本"）：界面不做数字统计，
// 也不做 int→string 转换。
export struct OrganizeRow {
    name: string,
    count: string,
}

// 阅读历史流水一行（V1.1；设计稿 H1）。
//
// 全部字段由 Rust 的 `history_view::project` 给出：时间标签、位置标签、
// 进入方式与语义色**都是 Rust 的判定**；界面只渲染（不排序、不格式化时间）。
export struct HistoryRow {
    id: string,
    book-id: string,
    // 时间标签：今天 HH:MM / 本年 MM-DD HH:MM / 跨年 yyyy-MM-dd HH:MM。
    time-label: string,
    book-title: string,
    // 文件名（定位符末段；不暴露绝对路径）。
    file-label: string,
    position-label: string,
    entry-kind-label: string,
    // 语义色槽位：0=中性（书架打开）2=成功（进度恢复/书签/章节跳转）。
    entry-kind-tone: int,
}

// 阅读历史按书聚合的组头一行（V1.1；设计稿 H2）。
export struct HistoryGroupHead {
    book-id: string,
    book-title: string,
    count: int,
    last-time-label: string,
    expanded: bool,
}

// 目录一行（序号 / 标题 / 偏移量都由 Rust 给出；当前章由 Rust 标记）。
export struct TocRow {
    sequence: string,
    title: string,
    meta: string,
    current: bool,
}

// 书签一行（位置与当前章标记由 Rust 给出）。
export struct MarkRow {
    id: string,
    chapter: string,
    title: string,
    position-label: string,
    current-chapter: bool,
    selected: bool,
    delete-pending: bool,
}

// 内容编码一行（名称与「当前」标记由 Rust 给出；界面不做编码语义）。
export struct ChoiceRow {
    name: string,
    current: bool,
    // 是否可选（V1.1：移动分类时自身与子孙不可选）。
    // 判定**完全来自 Rust**（`category_ops::move_targets`）；界面不得解析
    // 显示文案来推断 —— 那会把「循环可达性」语义下沉到 `.slint`。
    enabled: bool,
}

// 设置一行（键 / 名称 / 值 / 说明 / 控件类型都由 Rust 生成）。
//
// kind：0=字体族（循环字段）1=数值滑杆 2=枚举单选 3=布尔开关 4=只读文本行
// section：0=排版 1=版式 2=外观 3=交互 4=数据
export struct SettingsRow {
    key: string,
    label: string,
    value: string,
    note: string,
    effective: bool,
    kind: int,
    section: int,
    value-min: int,
    value-max: int,
    value-step: int,
    value-current: int,
    options: [string],
    // V1.1：基色色块（`kind = 8` 时有效；Rust 投影时算好，界面不解析颜色）。
    swatch: color,
    current-index: int,
    checked: bool,
    // 值文本用等宽字体（机器可核对信息，如数据库路径）。
    mono: bool,
    // 取值范围显示口径（如 `12 … 40`、`1.0 × … 2.4 ×`；空串隐藏）。
    range-label: string,
    // 行高与内容坐标 y（Rust 投影；界面按此绝对定位每一行）。
    row-height: length,
    offset-y: length,
}

// 快捷键说明一行（action/keys 由 Rust 生成；available=false 为建议项）。
export struct ShortcutEntry {
    action: string,
    keys: string,
    available: bool,
}

// 导入步骤一行（state：0=未开始 1=进行中 2=已完成）。
export struct StepRow {
    label: string,
    state: int,
}

// ---------------------------------------------------------------------------
// 版式常量投影入口（数值由 Rust 注入，此处只有声明）
// ---------------------------------------------------------------------------

export global UiMetrics {
    // 窗口与条带
    in property <length> top-bar-height: 0px;
    in property <length> toolbar-height: 0px;
    in property <length> toolbar-height-compact: 0px;
    in property <length> collapsed-toolbar-height: 0px;
    in property <length> floating-toolbar-height: 0px;
    in property <length> status-bar-height: 0px;
    in property <length> progress-bar-height: 0px;
    in property <length> progress-bar-hover-height: 0px;
    in property <length> content-padding-h: 0px;
    in property <length> content-padding-v: 0px;
    in property <length> content-padding-h-wide: 0px;
    in property <length> content-padding-compact: 0px;
    in property <length> breakpoint-wide: 0px;
    in property <length> breakpoint-compact: 0px;
    in property <length> breakpoint-narrow: 0px;
    // 紧凑模式上限（设计 §2.5：560–719 档 → 书架切卡片视图，避免表格列把书名挤到换行）。
    in property <length> breakpoint-tight: 0px;
    in property <length> default-window-width: 0px;
    in property <length> default-window-height: 0px;
    in property <length> min-window-width: 0px;
    in property <length> min-window-height: 0px;
    // 字号
    in property <length> title-font-size: 0px;
    in property <length> heading-font-size: 0px;
    in property <length> body-font-size: 0px;
    in property <length> ui-font-size: 0px;
    in property <length> label-font-size: 0px;
    in property <length> caption-font-size: 0px;
    in property <length> mono-font-size: 0px;
    in property <length> tag-font-size: 0px;
    // 导航
    in property <length> nav-tab-min-width: 0px;
    in property <length> nav-tab-height: 0px;
    in property <length> nav-indicator-height: 0px;
    // 控件
    in property <length> icon-button-size: 0px;
    in property <length> icon-button-compact-size: 0px;
    in property <length> button-height: 0px;
    in property <length> button-height-compact: 0px;
    in property <length> focus-ring-width: 0px;
    in property <length> search-field-width: 0px;
    in property <length> sort-field-width: 0px;
    in property <length> tag-height: 0px;
    in property <length> switch-width: 0px;
    in property <length> switch-height: 0px;
    in property <length> radio-size: 0px;
    in property <length> slider-handle-size: 0px;
    in property <length> slider-track-height: 0px;
    // 列表 / 表格
    in property <length> list-row-height: 0px;
    in property <length> table-row-height: 0px;
    in property <length> table-header-height: 0px;
    in property <length> column-status-width: 0px;
    in property <length> column-progress-width: 0px;
    in property <length> column-recent-width: 0px;
    in property <length> column-actions-width: 0px;
    in property <length> page-header-height: 0px;
    in property <length> panel-header-height: 0px;
    in property <length> panel-hint-height: 0px;
    // 分类侧栏（V1.1；数值由 Rust 的 layout.rs 注入）
    in property <length> sidebar-width: 0px;
    in property <length> sidebar-head-height: 0px;
    in property <length> sidebar-row-height: 0px;
    in property <length> sidebar-indent: 0px;
    in property <length> tree-arrow-size: 0px;
    in property <length> sidebar-collapsed-width: 0px;
    // 阅读历史（V1.1；数值由 Rust 的 layout.rs 注入）
    in property <length> history-row-height: 0px;
    in property <length> history-group-head-height: 0px;
    in property <length> history-time-width: 0px;
    in property <length> history-position-width: 0px;
    in property <length> history-kind-width: 0px;
    // 基色色块边长（V1.1；取色器）
    in property <length> swatch-size: 0px;
    // 滚动条
    in property <length> scrollbar-width: 0px;
    in property <length> scrollbar-gutter: 0px;
    in property <length> scrollbar-min-handle: 0px;
    // 覆盖层
    in property <length> toast-radius: 0px;
    in property <length> toast-width: 0px;
    in property <length> toast-height: 0px;
    in property <length> modal-width-confirm: 0px;
    in property <length> modal-width-settings: 0px;
    in property <length> card-width: 0px;
    in property <length> card-height: 0px;
    in property <length> cover-size: 0px;
    in property <length> empty-icon-size: 0px;
    // 间距阶
    in property <length> space-2: 0px;
    in property <length> space-4: 0px;
    in property <length> space-8: 0px;
    in property <length> space-12: 0px;
    in property <length> space-16: 0px;
    in property <length> space-24: 0px;
    in property <length> space-32: 0px;
    in property <length> space-48: 0px;
    // 线宽 / 图标 / 卡片文字 / 面板搜索
    in property <length> hairline: 0px;
    in property <length> brand-font-size: 0px;
    in property <length> icon-size: 0px;
    in property <length> cover-font-size: 0px;
    in property <length> card-title-font-size: 0px;
    in property <length> search-field-panel-width: 0px;
}

// ---------------------------------------------------------------------------
// 配色令牌投影入口（数值由 Rust 按当前主题注入；此处只有声明）
// ---------------------------------------------------------------------------

export global Skin {
    in property <color> background: #00000000;
    in property <color> layer-01: #00000000;
    in property <color> layer-02: #00000000;
    in property <color> field-01: #00000000;
    in property <color> border-subtle: #00000000;
    in property <color> border-strong: #00000000;
    in property <color> text-primary: #00000000;
    in property <color> text-secondary: #00000000;
    in property <color> text-placeholder: #00000000;
    in property <color> text-disabled: #00000000;
    in property <color> primary: #00000000;
    in property <color> primary-hover: #00000000;
    in property <color> primary-pressed: #00000000;
    in property <color> primary-soft: #00000000;
    in property <color> primary-border: #00000000;
    in property <color> primary-strong: #00000000;
    in property <color> on-primary: #00000000;
    in property <color> focus: #00000000;
    in property <color> header: #00000000;
    in property <color> header-text: #00000000;
    in property <color> header-hover: #00000000;
    in property <color> support-success: #00000000;
    in property <color> success-soft: #00000000;
    in property <color> support-warning: #00000000;
    in property <color> warning-soft: #00000000;
    in property <color> support-error: #00000000;
    in property <color> error-soft: #00000000;
    in property <color> scrollbar-track: #00000000;
    in property <color> scrollbar-handle: #00000000;
    in property <color> control-track: #00000000;
    in property <color> disabled-bg: #00000000;
    in property <color> disabled-border: #00000000;
    in property <color> disabled-text: #00000000;
    in property <color> overlay: #00000000;
    in property <color> toast-bg: #00000000;
    in property <color> toast-text: #00000000;
    in property <color> reading-text: #00000000;
    in property <color> cover-bg: #00000000;
}

// 页面序号（与 Rust `app_state::Screen` 对齐）。
export global Screens {
    out property <int> shelf: 0;
    out property <int> reader: 1;
    out property <int> settings: 2;
    out property <int> importing: 3;
    out property <int> error: 4;
}

